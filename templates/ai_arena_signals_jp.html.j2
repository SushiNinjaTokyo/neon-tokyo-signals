<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Arena Signals | Neon Tokyo Signals</title><link rel="stylesheet" href="/assets/ai_arena_signals_jp.css"/></head>
<body><main class="shell"><header class="hero"><p class="eyebrow">NEON TOKYO AI ARENA</p><h1>Arena Signals</h1><p>Score date: <strong>{{ payload.score_date }}</strong> / GPT notes: <strong>{{ 'ON' if payload.gpt_notes_enabled else 'OFF' }}</strong></p></header>
{% for agent in payload.agents %}<section class="agent-section"><div class="agent-title"><img src="{{ agent.image }}"/><div><p>{{ agent.role }}</p><h2>{{ agent.name }}</h2></div></div><div class="pick-grid">{% for p in agent.picks %}<article class="pick"><div class="pick-head"><div><span class="badge {{ p.action|lower }}">{{ p.action }}</span><h3>{{ p.ticker }}</h3><p>{{ p.name }}</p></div><strong>{{ '%.1f'|format(p.score*100) }}</strong></div><div class="metrics"><span>5D {{ '%.1f'|format(p.metrics.return_5d_pct or 0) }}%</span><span>20D {{ '%.1f'|format(p.metrics.return_20d_pct or 0) }}%</span><span>Vol {{ '%.2f'|format(p.metrics.volume_ratio_20d or 0) }}x</span><span>RSI {{ '%.1f'|format(p.metrics.rsi_14 or 0) }}</span></div><p class="note"><b>Thesis:</b> {{ p.notes.signal_thesis_en }}</p><p class="note"><b>Risk:</b> {{ p.notes.risk_comment_en }}</p></article>{% endfor %}</div></section>{% endfor %}
</main></body></html>
