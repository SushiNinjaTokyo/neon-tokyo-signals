<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Neon Tokyo Signals | Japan Equity Signals After the Tokyo Close</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Neon Tokyo Signals turns Japan equity momentum, breakouts, liquidity shocks and themes into readable signals for global investors after the Tokyo close."/>
  <meta name="theme-color" content="#050711"/>
  <link rel="stylesheet" href="/assets/index.css?v=20260521-market-pulse-real"/>
</head>

<body>
<div class="page">
  <div class="ambient ambient-a"></div>
  <div class="ambient ambient-b"></div>
  <div class="ambient ambient-c"></div>
  <div class="grid"></div>

  <main class="wrap">
    <section class="tokyo-pulse-panel" aria-label="Neon Tokyo market pulse">
      <div class="pulse-stage" id="pulseStage" data-tone="nikkei">
        <div class="pulse-bg-grid"></div>

        <div class="pulse-brand">
          <a class="brand-lockup" href="/" aria-label="Neon Tokyo Signals home">
            <span class="brand-mark">NTS</span>
            <span>
              <strong>NEON TOKYO SIGNALS</strong>
              <em>Japan equity signals after the Tokyo close.</em>
            </span>
          </a>

          <nav class="top-nav" aria-label="Primary navigation">
            <a href="/japan/daily/">Daily</a>
            <a href="/japan/weekly/">Weekly</a>
            <a href="/japan/daily/simulation/">Simulation</a>
            <a href="/japan/weekly-backtest/">Research</a>
          </nav>
        </div>

        <div class="pulse-bg-word" id="pulseBgWord" data-text="NIKKEI">NIKKEI</div>
        <div class="pulse-scan"></div>
        <div class="pulse-noise"></div>

        <div class="pulse-copy">
          <div class="pulse-kicker">
            <span class="live-dot"></span>
            TOKYO CLOSE // SIGNAL BOARD
          </div>

          <h1 class="hero-title">
            <span class="hero-title-line muted-line">Tokyo is closed.</span>
            <span class="hero-title-line signal-line">The signals are live.</span>
          </h1>

          <p>Momentum. Breakouts. Liquidity shocks. Japan themes.</p>
        </div>

        <div class="pulse-chart-wrap">
          <svg class="pulse-chart" viewBox="0 0 1000 360" preserveAspectRatio="none" aria-hidden="true">
            {% for item in market_pulse %}
            <path class="pulse-path pulse-path-{{ loop.index0 }}" data-label="{{ item.label }}" data-tone="{{ item.tone }}" data-perf="{{ item.performance_label }}" data-perf-class="{{ item.performance_class }}" data-symbol="{{ item.symbol }}" data-points="{{ item.points }}"></path>
            {% endfor %}
            <path class="pulse-trace" d=""></path>
          </svg>
        </div>

        <div class="pulse-corner-meta">
          <span id="pulseLabel">NIKKEI</span>
          <strong id="pulsePerf" class="ret-flat">1Y —</strong>
          <em id="pulseSymbol">JP MARKET PULSE</em>
        </div>
      </div>
    </section>

    <section class="ticker-strip" aria-label="Signal watch ticker">
      <div class="ticker-noise"></div>
      <div class="ticker-track">
        {% for _ in range(2) %}
        <span class="ticker-chip"><b>SIGNAL WATCH</b></span>
        {% for item in ticker_items %}
        <span class="ticker-chip">
          <b>{{ item.symbol }}</b>
          <small>{{ item.name }}</small>
          <i class="{{ item.return_class }}">{{ item.return_1d_label }}</i>
        </span>
        {% endfor %}
        {% endfor %}
      </div>
    </section>

    <section class="signal-hub" aria-label="Signal navigation hub">
      <div class="hub-heading">
        <div>
          <span class="hub-kicker">SIGNAL ACCESS</span>
          <h2>Choose the time frame.</h2>
        </div>
        <p>Daily is for short-term execution. Weekly is for trend discovery.</p>
      </div>

      <div class="hub-grid">
        <details class="hub-card daily" open>
          <summary>
            <span class="hub-no">01</span>
            <span>
              <em>Tokyo Close</em>
              <strong>Daily</strong>
            </span>
            <i>Open</i>
          </summary>
          <div class="hub-links">
            <a href="/japan/daily/"><span>Signal</span><strong>Daily Symbol</strong></a>
            <a href="/japan/daily/backtest/"><span>Research</span><strong>Backtest</strong></a>
            <a href="/japan/daily/simulation/"><span>Capital replay</span><strong>Simulation</strong></a>
          </div>
        </details>

        <details class="hub-card weekly">
          <summary>
            <span class="hub-no">02</span>
            <span>
              <em>Trend Layer</em>
              <strong>Weekly</strong>
            </span>
            <i>Open</i>
          </summary>
          <div class="hub-links">
            <a href="/japan/weekly/"><span>Signal</span><strong>Weekly Symbol</strong></a>
            <a href="/japan/weekly-backtest/"><span>Research</span><strong>Backtest</strong></a>
            <a href="/japan/weekly-simulation/"><span>Capital replay</span><strong>Simulation</strong></a>
          </div>
        </details>
      </div>
    </section>

    <section class="theme-pills" aria-label="Featured themes">
      <span>SEMICONDUCTOR CAPEX</span>
      <span>DEFENSE & AEROSPACE</span>
      <span>PHYSICAL AI</span>
      <span>DATA CENTER INFRA</span>
      <span>ROBOTICS</span>
      <span>EDGE AI</span>
    </section>

    <footer class="footer">
      <span>Informational only. Not investment advice.</span>
      <span>Latest prices: {{ status.latest_price_date or "—" }}</span>
      <nav aria-label="Footer navigation">
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/privacy/">Privacy</a>
      </nav>
    </footer>
  </main>
</div>

<script>
function pathFromPoints(points, width = 1000, height = 360) {
  if (!points || points.length < 2) return "";

  const coords = points.map((p, i) => {
    const x = (i / (points.length - 1)) * width;
    const y = height - (Math.max(0, Math.min(100, Number(p))) / 100) * (height - 44) - 22;
    return [x, y];
  });

  let d = `M ${coords[0][0].toFixed(2)} ${coords[0][1].toFixed(2)}`;

  for (let i = 1; i < coords.length; i++) {
    const prev = coords[i - 1];
    const curr = coords[i];
    const cx1 = (prev[0] + curr[0]) / 2;
    const cx2 = (prev[0] + curr[0]) / 2;
    d += ` C ${cx1.toFixed(2)} ${prev[1].toFixed(2)}, ${cx2.toFixed(2)} ${curr[1].toFixed(2)}, ${curr[0].toFixed(2)} ${curr[1].toFixed(2)}`;
  }

  return d;
}

const stage = document.getElementById("pulseStage");
const bgWord = document.getElementById("pulseBgWord");
const label = document.getElementById("pulseLabel");
const perf = document.getElementById("pulsePerf");
const symbol = document.getElementById("pulseSymbol");
const paths = Array.from(document.querySelectorAll(".pulse-path"));
const trace = document.querySelector(".pulse-trace");

const pulseData = paths.map((path) => {
  const raw = path.getAttribute("data-points") || "";
  const points = raw.split(",").map(Number).filter(v => Number.isFinite(v));
  const smooth = pathFromPoints(points);

  path.setAttribute("d", smooth);

  return {
    path,
    points,
    smooth,
    label: path.getAttribute("data-label") || "TOKYO",
    tone: path.getAttribute("data-tone") || "nikkei",
    performance: path.getAttribute("data-perf") || "—",
    performanceClass: path.getAttribute("data-perf-class") || "ret-flat",
    symbol: path.getAttribute("data-symbol") || "JP MARKET"
  };
}).filter(d => d.points.length >= 2);

let activeIndex = 0;

function restartTraceAnimation() {
  if (!trace) return;
  trace.style.animation = "none";
  void trace.getBoundingClientRect();
  trace.style.animation = "";
}

function activatePulse(i) {
  if (!pulseData.length || !stage || !bgWord || !trace) return;

  const item = pulseData[i % pulseData.length];

  stage.dataset.tone = item.tone || "nikkei";
  bgWord.textContent = item.label;
  bgWord.setAttribute("data-text", item.label);

  if (label) label.textContent = item.label;
  if (symbol) symbol.textContent = `${item.symbol} · 1Y PERFORMANCE`;
  if (perf) {
    perf.textContent = item.performance;
    perf.className = item.performanceClass;
  }

  paths.forEach(p => p.classList.remove("active"));
  item.path.classList.add("active");

  trace.setAttribute("d", item.smooth);
  restartTraceAnimation();
}

activatePulse(activeIndex);

setInterval(() => {
  activeIndex = (activeIndex + 1) % Math.max(1, pulseData.length);
  activatePulse(activeIndex);
}, 2600);

if (bgWord) {
  function triggerPulseNoise() {
    bgWord.classList.add("is-noisy");
    const noiseDuration = 70 + Math.random() * 150;
    setTimeout(() => bgWord.classList.remove("is-noisy"), noiseDuration);
    const nextNoise = 1800 + Math.random() * 4200;
    setTimeout(triggerPulseNoise, nextNoise);
  }
  setTimeout(triggerPulseNoise, 1200 + Math.random() * 1600);
}
</script>
</body>
</html>
