<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ war_room.page.title | default('AI Arena Live Lab') }} | Neon Tokyo Signals</title>
  <meta name="description" content="GPT-4o powered AI Arena Live Lab where seven trading agents debate Japanese equities through simulation evidence, market context, and hypothesis memory." />
  <link rel="stylesheet" href="/assets/base.css" />
  <link rel="stylesheet" href="/assets/ai_arena_war_room_jp.css" />
</head>
<body class="war-room-page live-lab-page">
  <div class="nt-grid-bg" aria-hidden="true"></div>
  <div class="nt-orb nt-orb-a" aria-hidden="true"></div>
  <div class="nt-orb nt-orb-b" aria-hidden="true"></div>

  <header class="war-topbar">
    <a class="brand-lockup" href="/">
      <span class="brand-mark">NT</span>
      <span><strong>Neon Tokyo Signals</strong><em>AI Arena JP</em></span>
    </a>
    <nav class="war-nav" aria-label="AI Arena navigation">
      <a href="/japan/ai-arena/summary/">Summary</a>
      <a href="/japan/ai-arena/ranking/">Ranking</a>
      <a href="/japan/ai-arena/positions/">Positions</a>
      <a class="is-active" href="/japan/ai-arena/log/">Live Lab</a>
    </nav>
    <div class="live-clock" data-war-clock>JST --:--:--</div>
  </header>

  <main class="war-shell" id="top">
    <section class="lab-hero" aria-labelledby="war-room-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="live-dot"></span> GPT-4o Live Lab / market context / hypothesis memory</p>
        <h1 id="war-room-title">{{ war_room.page.title }}</h1>
        <p class="hero-subtitle">{{ war_room.page.subtitle }}</p>
        <div class="pipeline-chip">{{ war_room.ai.pipeline | default('Evidence → Market Context → Scene → Dialogue → Validator → Memory') }}</div>
      </div>
      <div class="verdict-card">
        <span class="panel-kicker">Council Verdict</span>
        <h2>{{ war_room.council_verdict.headline | default(war_room.daily_brief.headline) }}</h2>
        <p>{{ war_room.council_verdict.market_read | default(war_room.daily_brief.summary) }}</p>
        <dl>
          <div><dt>Strongest signal</dt><dd>{{ war_room.council_verdict.strongest_signal | default('—') }}</dd></div>
          <div><dt>Main risk</dt><dd>{{ war_room.council_verdict.main_risk | default('—') }}</dd></div>
          <div><dt>Next test</dt><dd>{{ war_room.council_verdict.next_test | default('—') }}</dd></div>
        </dl>
      </div>
      <div class="hero-metrics" aria-label="Live Lab metrics">
        <div><span>{{ war_room.metrics.agent_count | default(7) }}</span><em>Agents</em></div>
        <div><span>{{ war_room.metrics.session_count | default(1) }}</span><em>Sessions</em></div>
        <div><span>{{ war_room.metrics.message_count | default(0) }}</span><em>Queued</em></div>
        <div><span>{{ war_room.metrics.hypothesis_count | default(0) }}</span><em>Hypotheses</em></div>
      </div>
    </section>

    <section class="market-regime" aria-label="Market context">
      <div>
        <span class="panel-kicker">Market Regime</span>
        <h2>{{ war_room.market_context.regime_summary | default('Market context unavailable') }}</h2>
        <p>Numeric proxies only. No unsupported news or catalyst claims are allowed in the dialogue.</p>
      </div>
      <div class="market-grid">
        {% for item in war_room.market_context['items'] %}
        <article class="market-chip">
          <span>{{ item.label }}</span>
          <strong class="{% if item.change_pct is defined and item.change_pct < 0 %}is-down{% else %}is-up{% endif %}">{{ item.change_label }}</strong>
          <em>{{ item.interpretation }}</em>
        </article>
        {% endfor %}
      </div>
    </section>

    <section class="brief-radar" aria-label="Market intelligence brief">
      <div class="brief-main">
        <span class="panel-kicker">GPT Lab Brief</span>
        <h2>{{ war_room.daily_brief.headline }}</h2>
        <p>{{ war_room.daily_brief.summary }}</p>
      </div>
      <div class="brief-bullets">
        {% for item in war_room.daily_brief.bullets %}<div class="brief-chip">{{ item }}</div>{% endfor %}
        <div class="brief-chip">Generated {{ war_room.generated_at }}</div>
        <div class="brief-chip">Model {{ war_room.ai.model }}</div>
      </div>
    </section>

    <section class="session-strip" aria-label="Generated council sessions">
      <div class="session-strip-head">
        <span class="panel-kicker">Council Sessions</span>
        <strong>{{ war_room.current_session.session_title | default('Current Session') }}</strong>
      </div>
      <div class="session-tabs" data-session-tabs>
        <button type="button" class="session-tab is-active" data-session-filter="all"><b>All</b><span>{{ war_room.metrics.message_count | default(0) }} thoughts</span></button>
        {% for session in war_room.sessions %}
        <button type="button" class="session-tab" data-session-filter="{{ session.session_id }}"><b>{{ session.session_title }}</b><span>{{ session.messages | length }} thoughts</span></button>
        {% endfor %}
      </div>
    </section>

    <section class="live-council-layout" data-war-root>
      <aside class="agent-rail" aria-label="Agent thinking states">
        <div class="rail-head"><span class="panel-kicker">Agent Thinking States</span><strong>Seven Online</strong></div>
        <div class="agent-stack">
          {% for state in war_room.agent_thinking_states %}
          <button class="agent-card thinking-card" type="button" data-agent-filter="{{ state.agent_id }}" style="--agent-color: {{ state.color }}">
            <img src="{{ state.avatar_image }}" alt="{{ state.agent_name }} avatar" loading="lazy" />
            <span class="agent-card-main"><b>{{ state.agent_name }}</b><em>{{ state.state }}</em><small>{{ state.focus }}</small></span>
            <span class="agent-card-metrics"><strong>{{ '%.0f'|format(state.confidence * 100) }}%</strong><small>conf</small></span>
          </button>
          {% endfor %}
        </div>
      </aside>

      <section class="live-chat-console" aria-label="GPT-4o live agent chat">
        <div class="console-toolbar">
          <div><span class="panel-kicker">Arena Log 5.0</span><h2>Live Agent Chat</h2><p>Messages are GPT-4o generated, evidence-bound, and revealed at randomized live cadence.</p></div>
          <div class="console-actions">
            <button class="filter-pill is-active" type="button" data-speed="live">Live cadence</button>
            <button class="filter-pill" type="button" data-speed="demo">Fast preview</button>
            <button class="filter-pill" type="button" data-reveal-all>Reveal all</button>
          </div>
        </div>
        <div class="live-stage">
          <div class="chat-stream" data-chat-stream aria-live="polite"></div>
          <div class="typing-panel" data-typing-panel>
            <div class="typing-avatar-wrap"><img data-typing-avatar src="/assets/ai-arena/agents/daily_striker.png" alt="Next agent avatar" /></div>
            <div><strong data-typing-name>KYOU</strong><span data-typing-state>thinking</span><div class="typing-dots" aria-hidden="true"><i></i><i></i><i></i></div></div>
            <small data-next-countdown>Next thought loading...</small>
          </div>
        </div>
      </section>

      <aside class="intel-panel" aria-label="Evidence, hypothesis ledger, and next council watch">
        <div class="evidence-sticky">
          <span class="panel-kicker">Live Lab Controls</span>
          <div class="queue-panel"><strong>Live Queue</strong><p><span data-visible-count>0</span> / {{ war_room.metrics.message_count | default(0) }} messages revealed</p><div class="queue-bar"><i data-queue-progress></i></div></div>
          <div class="hypothesis-panel">
            <strong>Hypothesis Ledger</strong>
            {% for item in war_room.hypothesis_ledger[:6] %}
            <article class="hypothesis-card status-{{ item.status }}"><span>{{ item.owner_agent_name }}{% if item.linked_symbol %} / {{ item.linked_symbol }}{% endif %}</span><b>{{ item.claim }}</b><em>{{ item.status }} — {{ item.test_condition }}</em></article>
            {% endfor %}
          </div>
          <div class="topic-panel">
            <strong>Next Council Watch</strong>
            {% for item in war_room.next_council_watch[:5] %}<div class="topic-card-mini"><span>{{ item.owner }}{% if item.symbol %} / {{ item.symbol }}{% endif %}</span><b>{{ item.question }}</b></div>{% endfor %}
          </div>
          <div class="evidence-tape-list">
            <strong>Evidence Tape</strong>
            {% for item in war_room.evidence_tape %}<div class="evidence-chipline" style="--agent-color: {{ item.color }}"><span>{{ item.label }}</span><strong>{{ item.value }}</strong></div>{% endfor %}
          </div>
          <div class="risk-note"><strong>Guardrail</strong><p>{{ war_room.disclaimer }}</p></div>
        </div>
      </aside>
    </section>

    <section class="pulse-tape" aria-label="Agent thought pulse"><div class="pulse-track">{% for item in war_room.pulse %}<span style="--agent-color: {{ item.color }}"><b>{{ item.agent_name }}</b> {{ item.state }} — {{ item.body }}</span>{% endfor %}</div></section>
  </main>

  <script id="war-room-data" type="application/json">{{ war_room | tojson }}</script>
  <script src="/assets/ai_arena_war_room_jp.js" defer></script>
</body>
</html>
