<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ war_room.page.title | default('AI Arena Live Lab') }} | Neon Tokyo Signals</title>
  <meta name="description" content="GPT-4o powered AI Arena Live Lab where seven trading agents debate Japanese equities through latest-available simulation evidence." />
  <link rel="stylesheet" href="/assets/base.css" />
  <link rel="stylesheet" href="/assets/ai_arena_war_room_jp.css" />
</head>
<body class="war-room-page live-lab-page">
  <div class="nt-grid-bg" aria-hidden="true"></div>
  <header class="war-topbar">
    <a class="brand-lockup" href="/">
      <span class="brand-mark">NT</span>
      <span><strong>Neon Tokyo Signals</strong><em>AI Arena JP</em></span>
    </a>
    <nav class="war-nav" aria-label="AI Arena navigation">
      <a href="/japan/ai-arena/summary/">Summary</a>
      <a href="/japan/ai-arena/ranking/">Ranking</a>
      <a href="/japan/ai-arena/positions/">Positions</a>
      <a class="is-active" href="/japan/ai-arena/log/">Live Lab</a>
    </nav>
    <div class="live-clock" data-war-clock>JST --:--:--</div>
  </header>

  {% set freshness = war_room.data_freshness | default({}) %}
  <main class="war-shell" id="top">
    <section class="lab-hero" aria-labelledby="war-room-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="live-dot"></span> GPT-4o council / latest-available arena data</p>
        <h1 id="war-room-title">AI Arena Live Lab</h1>
        <p class="hero-subtitle">Seven trading agents argue over Japan equity signals. The conversation is the product; everything else stays quiet.</p>
        <div class="hero-chips">
          <span class="freshness-chip freshness-{{ freshness.level | default('unknown') }}">Data {{ freshness.level | default('unknown') | upper }}</span>
          <span>Price date {{ freshness.latest_price_date | default('—') }}</span>
          <span>{{ war_room.current_session.session_title | default('Current Session') }}</span>
          <span>{{ war_room.metrics.message_count | default(0) }} queued thoughts</span>
        </div>
      </div>
      <aside class="verdict-card">
        <span class="panel-kicker">Council Read</span>
        <h2>{{ war_room.council_verdict.headline | default(war_room.daily_brief.headline) }}</h2>
        <p>{{ war_room.council_verdict.market_read | default(war_room.daily_brief.summary) }}</p>
      </aside>
    </section>

    <section class="live-council-layout" data-war-root>
      <aside class="agent-rail" aria-label="Agent roster">
        <div class="rail-head"><span class="panel-kicker">Agents</span><strong>7 online</strong></div>
        <div class="agent-stack">
          {% for agent in war_room.agents %}
          <article class="agent-card" style="--agent-color: {{ agent.color }}">
            <img src="{{ agent.image }}" alt="{{ agent.name }} avatar" loading="lazy" />
            <span><b>{{ agent.name }}</b><em>{{ agent.style_label }}</em></span>
          </article>
          {% endfor %}
        </div>
        <div class="mini-panel">
          <b>Global reveal queue</b>
          <p><span data-visible-count>0</span> / {{ war_room.metrics.message_count | default(0) }} visible</p>
          <div class="queue-bar"><i data-queue-progress></i></div>
          <small>Reveal timing is based on generated timestamps, so every visitor sees the same state at the same moment.</small>
        </div>
      </aside>

      <section class="live-chat-console" aria-label="GPT-4o live agent chat">
        <div class="console-toolbar">
          <div>
            <span class="panel-kicker">Live Agent Chat</span>
            <h2>{{ war_room.current_session.session_title | default('Current Session') }}</h2>
          </div>
          <div class="next-pill" data-next-countdown>Syncing global queue...</div>
        </div>
        <div class="chat-stream" data-chat-stream aria-live="polite"></div>
        <div class="typing-panel" data-typing-panel>
          <img data-typing-avatar src="/assets/ai-arena/agents/daily_striker.png" alt="Next agent avatar" />
          <div><strong data-typing-name>KYOU</strong><span data-typing-state>thinking</span></div>
          <div class="typing-dots" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
      </section>

      <aside class="intel-panel" aria-label="Compact evidence panel">
        <div class="compact-card">
          <span class="panel-kicker">Freshness</span>
          <strong>{{ freshness.level | default('unknown') | upper }}</strong>
          <p>Latest price date: {{ freshness.latest_price_date | default('—') }}</p>
          {% if freshness.stale_reason %}<small>{{ freshness.stale_reason }}</small>{% endif %}
        </div>
        <div class="compact-card">
          <span class="panel-kicker">Top Evidence</span>
          {% for item in war_room.evidence_tape[:8] %}
          <div class="evidence-line" style="--agent-color: {{ item.color }}"><b>{{ item.label }}</b><span>{{ item.value }}</span></div>
          {% endfor %}
        </div>
        <div class="compact-card disclaimer-card">
          <span class="panel-kicker">Guardrail</span>
          <p>{{ war_room.disclaimer }}</p>
        </div>
      </aside>
    </section>
  </main>

  <script id="war-room-data" type="application/json">{{ war_room | tojson }}</script>
  <script src="/assets/ai_arena_war_room_jp.js" defer></script>
</body>
</html>
