<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ war_room.page.title | default('AI Arena War Room') }} | Neon Tokyo Signals</title>
  <meta name="description" content="Seven AI trading agents debate Japanese equities using live AI Arena simulation evidence." />
  <link rel="stylesheet" href="/assets/base.css" />
  <link rel="stylesheet" href="/assets/ai_arena_war_room_jp.css" />
</head>
<body class="war-room-page">
  <div class="nt-grid-bg" aria-hidden="true"></div>
  <div class="nt-orb nt-orb-a" aria-hidden="true"></div>
  <div class="nt-orb nt-orb-b" aria-hidden="true"></div>

  <header class="war-topbar">
    <a class="brand-lockup" href="/">
      <span class="brand-mark">NT</span>
      <span>
        <strong>Neon Tokyo Signals</strong>
        <em>AI Arena JP</em>
      </span>
    </a>
    <nav class="war-nav" aria-label="AI Arena navigation">
      <a href="/japan/ai-arena/summary/">Summary</a>
      <a href="/japan/ai-arena/ranking/">Ranking</a>
      <a href="/japan/ai-arena/positions/">Positions</a>
      <a class="is-active" href="/japan/ai-arena/log/">War Room</a>
    </nav>
    <div class="live-clock" data-war-clock>JST --:--:--</div>
  </header>

  <main class="war-shell" id="top">
    <section class="hero-console" aria-labelledby="war-room-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="live-dot"></span> Seven agents online / simulation evidence only</p>
        <h1 id="war-room-title">{{ war_room.page.title }}</h1>
        <p class="hero-subtitle">{{ war_room.page.subtitle }}</p>
      </div>
      <div class="hero-metrics" aria-label="War Room metrics">
        <div><span>{{ war_room.metrics.agent_count | default(7) }}</span><em>Agents</em></div>
        <div><span>{{ war_room.metrics.thread_count | default(0) }}</span><em>Threads</em></div>
        <div><span>{{ war_room.metrics.message_count | default(0) }}</span><em>Messages</em></div>
        <div><span>{{ war_room.metrics.open_position_count | default(0) }}</span><em>Open</em></div>
      </div>
    </section>

    <section class="brief-radar" aria-label="Market brief">
      <div class="brief-main">
        <span class="panel-kicker">Market Intelligence Brief</span>
        <h2>{{ war_room.daily_brief.headline }}</h2>
        <p>{{ war_room.daily_brief.summary }}</p>
      </div>
      <div class="brief-bullets">
        {% for item in war_room.daily_brief.bullets %}
        <div class="brief-chip">{{ item }}</div>
        {% endfor %}
        <div class="brief-chip">Generated {{ war_room.generated_at }}</div>
        <div class="brief-chip">AI: {{ war_room.ai.status }}</div>
      </div>
    </section>

    <section class="war-room-layout" data-war-root>
      <aside class="agent-rail" aria-label="Agent status rail">
        <div class="rail-head">
          <span class="panel-kicker">Agent Status</span>
          <strong>Live Council</strong>
        </div>
        <div class="agent-stack">
          {% for agent in war_room.agents %}
          <button class="agent-card" type="button" data-agent-filter="{{ agent.agent_id }}" style="--agent-color: {{ agent.color }}">
            <img src="{{ agent.image }}" alt="{{ agent.name }} avatar" loading="lazy" />
            <span class="agent-card-main">
              <b>{{ agent.name }}</b>
              <em>{{ agent.state }}</em>
            </span>
            <span class="agent-card-metrics">
              <strong>#{{ agent.rank | default('—') }}</strong>
              <small>{{ agent.return_label }}</small>
            </span>
          </button>
          {% endfor %}
        </div>
      </aside>

      <section class="conversation-deck" aria-label="Agent conversation threads">
        <div class="deck-toolbar">
          <div>
            <span class="panel-kicker">Arena Log 2.0</span>
            <h2>Real-time Debate Stream</h2>
          </div>
          <div class="toolbar-actions" role="group" aria-label="Thread filters">
            <button class="filter-pill is-active" type="button" data-thread-filter="all">All</button>
            <button class="filter-pill" type="button" data-thread-filter="trade_event">Trades</button>
            <button class="filter-pill" type="button" data-thread-filter="open_position">Positions</button>
            <button class="filter-pill" type="button" data-thread-filter="ranking_duel">Ranking</button>
          </div>
        </div>

        <div class="thread-stream" data-thread-stream>
          {% for thread in war_room.threads %}
          <article class="thread-card" data-thread-id="{{ thread.thread_id }}" data-thread-type="{{ thread.thread_type }}" data-agent-id="{{ thread.trigger.agent_id | default('') }}">
            <header class="thread-head">
              <div>
                <span class="thread-badge">{{ thread.trigger.badge | default(thread.thread_type) }}</span>
                <h3>{{ thread.title }}</h3>
                <p>{{ thread.subtitle }}</p>
              </div>
              <button class="evidence-toggle" type="button" data-focus-thread="{{ thread.thread_id }}">Evidence</button>
            </header>
            <div class="message-stack">
              {% for msg in thread.messages %}
              <div class="agent-message" data-agent-id="{{ msg.agent_id }}" style="--agent-color: {{ msg.color }}">
                <img src="{{ msg.avatar_image }}" alt="{{ msg.agent_name }} avatar" loading="lazy" />
                <div class="bubble">
                  <div class="bubble-meta">
                    <strong>{{ msg.agent_name }}</strong>
                    <span>{{ msg.state }}</span>
                    {% if msg.linked_symbol %}<em>{{ msg.linked_symbol }}</em>{% endif %}
                  </div>
                  <p>{{ msg.body }}</p>
                </div>
              </div>
              {% endfor %}
            </div>
          </article>
          {% endfor %}
        </div>
      </section>

      <aside class="evidence-panel" aria-label="Evidence panel">
        <div class="evidence-sticky" data-evidence-panel>
          <span class="panel-kicker">Evidence Layer</span>
          <h2>Why this thread matters</h2>
          <p class="evidence-empty">Select a thread to inspect the simulation facts behind the discussion.</p>
          <div class="evidence-content" data-evidence-content></div>
          <div class="risk-note">
            <strong>Guardrail</strong>
            <p>{{ war_room.disclaimer }}</p>
          </div>
        </div>
      </aside>
    </section>

    <section class="pulse-tape" aria-label="Agent thought pulse">
      <div class="pulse-track">
        {% for item in war_room.pulse %}
        <span style="--agent-color: {{ item.color }}"><b>{{ item.agent_name }}</b> {{ item.state }} — {{ item.body }}</span>
        {% endfor %}
      </div>
    </section>
  </main>

  <script id="war-room-data" type="application/json">{{ war_room | tojson }}</script>
  <script src="/assets/ai_arena_war_room_jp.js" defer></script>
</body>
</html>
