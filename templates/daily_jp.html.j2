<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Daily Japan Signals | Neon Tokyo Signals</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Daily Japan equity decision board after the Tokyo close. Trade-first short-term signal board with market pulse charts and recent Trade outcomes."/>
  <meta name="theme-color" content="#050711"/>
  <link rel="stylesheet" href="/assets/daily_jp.css?v={{ asset_version }}"/>
</head>
<body>
<div class="page-shell daily-premium">
  <div class="ambient ambient-a"></div>
  <div class="ambient ambient-b"></div>
  <div class="ambient ambient-c"></div>
  <div class="grid"></div>
  <div class="scanline"></div>

  <main class="wrap">
    <header class="header">
      <a class="brand" href="/">
        <span class="brand-mark">NTS</span>
        <span><strong>NEON TOKYO SIGNALS</strong><em>Japan equity signals after the Tokyo close.</em></span>
      </a>
      <nav class="nav">
        <a href="/">Home</a>
        <a href="/japan/daily/" class="active">Daily</a>
        <a href="/japan/daily/backtest/">Backtest</a>
        <a href="/japan/daily/simulation/">Simulation</a>
        <a href="/japan/weekly/">Weekly</a>
      </nav>
    </header>

    <aside class="deprecated-ai-arena-banner" style="position:relative;z-index:20;margin:0 0 18px;padding:14px 16px;border:1px solid rgba(255,209,102,.28);border-radius:18px;background:linear-gradient(90deg,rgba(255,209,102,.10),rgba(125,249,255,.06));box-shadow:0 14px 34px rgba(0,0,0,.18);color:#EAF2FF;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;">
      <span style="display:inline-grid;gap:4px;min-width:0;">
        <strong style="color:#FFD166;font-size:11px;letter-spacing:.16em;text-transform:uppercase;">Deprecated legacy page</strong>
        <em style="color:rgba(184,199,222,.88);font-size:12px;font-style:normal;line-height:1.45;">This page is kept for historical reference. Neon Tokyo is now centered on AI Arena JP.</em>
      </span>
      <a href="/japan/ai-arena/summary/" style="display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:8px 12px;border:1px solid rgba(125,249,255,.38);border-radius:999px;color:#7DF9FF;background:rgba(125,249,255,.06);font-size:11px;font-weight:950;letter-spacing:.10em;text-transform:uppercase;text-decoration:none;white-space:nowrap;">Enter AI Arena →</a>
    </aside>


    <section class="hero cockpit hero-compact">
      <div class="hero-copy">
        <div class="kicker"><span class="live-dot"></span> DAILY JP DECISION BOARD · TOP {{ main_rank_limit }}</div>
        <h1>Trade only.<span>Noise off.</span></h1>
        <div class="verdict-card verdict-{{ setup_quality.verdict_tone }} compact-verdict">
          <div><span>Today</span><strong>{{ setup_quality.verdict }}</strong></div>
          <p>{{ setup_quality.trade_count }} Trade · {{ setup_quality.monitor_count }} Monitor · {{ setup_quality.ignore_count }} Blocked</p>
        </div>
        <div class="hero-mini-strip">
          <div><span>Trade</span><strong>{{ setup_quality.trade_count }}</strong></div>
          <div><span>Monitor</span><strong>{{ setup_quality.monitor_count }}</strong></div>
          <div><span>Risk</span><strong>{{ setup_quality.risk_count }}</strong></div>
        </div>
      </div>

      <aside class="hero-panels premium-stack">
        <article class="hero-panel trade-panel focus-card">
          <div class="panel-label">TRADE SIGNAL</div>
          {% if trade_signal %}
            <div class="ticker-row"><strong>{{ trade_signal.symbol }}</strong><span class="tag triage-trade">Trade</span></div>
            <div class="panel-name">{{ trade_signal.name }}</div>
            <div class="panel-score">{{ trade_signal.score_display }} <span>pts</span></div>
            <div class="decision-line">{{ trade_signal.decision_label }}</div>
          {% else %}
            <div class="ticker-row no-action"><strong>NO TRADE</strong><span class="tag triage-ignore">Capital first</span></div>
            <div class="panel-score muted">0 <span>trades</span></div>
          {% endif %}
        </article>

        <article class="hero-panel monitor-panel focus-card soft">
          <div class="panel-label">TOP MONITOR</div>
          {% if monitor_signal %}
            <div class="ticker-row"><strong>{{ monitor_signal.symbol }}</strong><span class="tag triage-watch">Monitor</span></div>
            <div class="panel-name">{{ monitor_signal.name }}</div>
            <div class="panel-score">{{ monitor_signal.score_display }} <span>pts</span></div>
          {% else %}
            <div class="ticker-row no-action"><strong>NONE</strong><span class="tag triage-ignore">Wait</span></div>
            <div class="panel-score muted">—</div>
          {% endif %}
        </article>
      </aside>
    </section>

    <section class="market-section premium-pulse-section">
      <div class="section-heading split-heading compact-heading">
        <div><div class="kicker">MARKET PULSE</div><h2>Index tape.</h2></div>
        <div class="method-chip">Animated 1Y weekly path</div>
      </div>
      <div class="pulse-chart-grid">
        {% for pulse in market_pulse %}
          <article class="pulse-chart-card">
            <div class="pulse-chart-head">
              <div><strong>{{ pulse.label }}</strong><span>{{ pulse.short_tape }}</span></div>
              <div class="pulse-performance {{ pulse.perf_1y_class }}">{{ pulse.perf_1y_display }}<em>1Y</em></div>
            </div>
            <svg class="pulse-spark" viewBox="0 0 100 44" preserveAspectRatio="none" aria-label="{{ pulse.label }} one year performance chart">
              <defs>
                <linearGradient id="pulseGrad{{ loop.index }}" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="#7df9ff"/>
                  <stop offset="0.55" stop-color="#5dffb1"/>
                  <stop offset="1" stop-color="#ff4fd8"/>
                </linearGradient>
              </defs>
              <polyline class="pulse-fill" points="0,44 {{ pulse.points }} 100,44"/>
              <polyline class="pulse-line" points="{{ pulse.points }}" stroke="url(#pulseGrad{{ loop.index }})"/>
            </svg>
            <div class="pulse-mini-metrics">
              <span class="{{ pulse.return_1d_pct_class }}">1D {{ pulse.return_1d_pct | fmt_pct }}</span>
              <span class="{{ pulse.return_5d_pct_class }}">5D {{ pulse.return_5d_pct | fmt_pct }}</span>
              <span class="{{ pulse.return_20d_pct_class }}">20D {{ pulse.return_20d_pct | fmt_pct }}</span>
            </div>
          </article>
        {% else %}
          <article class="empty-card">Market pulse data is not available yet.</article>
        {% endfor %}
      </div>
    </section>

    <section class="action-section">
      <div class="section-heading split-heading compact-heading"><div><div class="kicker">LIVE BOARD</div><h2>Trade / Monitor.</h2></div><div class="method-chip">Trade is the only buy lane</div></div>
      <div class="cards action-cards premium-action-cards">
        {% for item in trade_items + monitor_items %}
          <article class="signal-card {{ item.card_tone }} {{ item.score_class }} lean-card">
            <div class="card-top"><div class="rank">#{{ item.rank }}</div><div class="score">{{ item.score_display }}<span>pts</span></div></div>
            <div class="symbol-row"><h3>{{ item.symbol }}</h3><span class="tag triage-{{ (item.triage or 'unknown') | lower }}">{{ item.signal_status }}</span></div>
            <div class="name">{{ item.name }}</div>
            <div class="metric-grid compact-metrics">
              <div><span>1D</span><strong class="{{ item.return_1d_pct_class }}">{{ item.return_1d_pct | fmt_pct }}</strong></div>
              <div><span>5D</span><strong class="{{ item.return_5d_pct_class }}">{{ item.return_5d_pct | fmt_pct }}</strong></div>
              <div><span>Liquidity</span><strong>{{ item.liquidity_band }}</strong></div>
            </div>
          </article>
        {% else %}
          <article class="empty-card action-empty"><strong>No active Trade or Monitor today.</strong><span>Capital first.</span></article>
        {% endfor %}
      </div>
    </section>

    <section class="trade-history-section">
      <div class="section-heading split-heading compact-heading">
        <div><div class="kicker">LAST 10 TRADE SIGNALS</div><h2>Then vs now.</h2></div>
        <div class="method-chip">Latest price {{ prices_latest_date or '—' }}</div>
      </div>
      <div class="trade-history-grid">
        {% for item in recent_trade_signals %}
          <article class="trade-history-card">
            <div class="trade-history-top"><span>{{ item.eval_date }}</span><strong>#{{ item.rank }}</strong></div>
            <div class="trade-symbol"><strong>{{ item.symbol }}</strong><em>{{ item.name }}</em></div>
            <div class="trade-history-score"><span>{{ item.score_pts }} pts</span><span>{{ item.classification }}</span></div>
            <div class="trade-history-metrics">
              <div><span>Signal 1D</span><strong class="{{ item.return_1d_pct_class }}">{{ item.return_1d_pct | fmt_pct }}</strong></div>
              <div><span>Signal 5D</span><strong class="{{ item.return_5d_pct_class }}">{{ item.return_5d_pct | fmt_pct }}</strong></div>
              <div><span>Now</span><strong class="{{ item.current_perf_class }}">{{ item.current_perf_pct | fmt_pct }}</strong></div>
            </div>
          </article>
        {% else %}
          <article class="empty-card">No historical Trade signals available in the current backtest JSON.</article>
        {% endfor %}
      </div>
    </section>

    <footer class="footer"><span>Informational only. Not investment advice.</span><nav><a href="/">Home</a><a href="/japan/daily/backtest/">Backtest</a><a href="/japan/daily/simulation/">Simulation</a><a href="/privacy/">Privacy</a><a href="/disclaimer/">Disclaimer</a></nav></footer>
  </main>
</div>
</body>
</html>
