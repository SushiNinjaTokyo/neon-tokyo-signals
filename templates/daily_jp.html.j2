<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Daily Japan Signals | Neon Tokyo Signals</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Daily Japan equity signals after the Tokyo close. Ranked by volume shock, compression release, breakout quality, relative strength and entry discipline."/>
  <meta name="theme-color" content="#050711"/>
  <link rel="stylesheet" href="/assets/daily_jp.css?v={{ asset_version }}"/>
</head>

<body>
<div class="page">
  <div class="ambient ambient-a"></div>
  <div class="ambient ambient-b"></div>
  <div class="grid"></div>

  <main class="wrap">
    <header class="header">
      <a class="brand" href="/">
        <span class="brand-mark">NTS</span>
        <span>
          <strong>NEON TOKYO SIGNALS</strong>
          <em>Japan equity signals after the Tokyo close.</em>
        </span>
      </a>

      <nav class="nav">
        <a href="/">Home</a>
        <a href="/japan/daily/" class="active">Daily</a>
        <a href="/japan/weekly/">Weekly</a>
        <a href="/disclaimer/">Disclaimer</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <div class="kicker">
          <span class="live-dot"></span>
          DAILY JP EVENT SCORE V2
        </div>

        <h1>
          Tokyo close signals,
          <span>filtered by timing discipline.</span>
        </h1>

        <p>
          Ranked by volume/liquidity shock, compression release, breakout setup,
          relative strength versus TOPIX, entry timing and market regime. News is
          intentionally excluded in this version.
        </p>
      </div>

      <aside class="summary-card">
        <div class="summary-label">TOP SIGNAL</div>

        {% if summary.top_symbol %}
          <div class="summary-symbol">{{ summary.top_symbol }}</div>
          <div class="summary-name">{{ summary.top_name }}</div>

          <div class="summary-score">
            {% if summary.top_score_pts %}
              {{ summary.top_score_pts }}
              <span>pts / {{ summary.top_score | fmt_score }} score</span>
            {% else %}
              {{ summary.top_score | fmt_score }}
              <span>score</span>
            {% endif %}
          </div>

          <div class="summary-tags">
            <span class="tag triage-{{ (summary.top_triage or 'Unknown') | lower }}">
              {{ summary.top_triage or "—" }}
            </span>
            <span class="tag">{{ summary.top_archetype or "Mixed" }}</span>
          </div>
        {% else %}
          <div class="summary-symbol">NO DATA</div>
          <div class="summary-name">Daily signal JSON has not been generated yet.</div>
        {% endif %}
      </aside>
    </section>

    <section class="meta-strip">
      <div>
        <span>Generated</span>
        <strong>{{ generated_at or "—" }}</strong>
      </div>
      <div>
        <span>Price Data</span>
        <strong>{{ source_prices_generated_at or "—" }}</strong>
      </div>
      <div>
        <span>Regime</span>
        <strong>{{ payload.regime or "—" }}</strong>
      </div>
      <div>
        <span>Universe</span>
        <strong>{{ summary.items_count or 0 }} names</strong>
      </div>
    </section>

    <section class="triage-strip" aria-label="Triage summary">
      <div class="triage-box trade">
        <span>Trade</span>
        <strong>{{ summary.trade or 0 }}</strong>
      </div>
      <div class="triage-box watch">
        <span>Watch</span>
        <strong>{{ summary.watch or 0 }}</strong>
      </div>
      <div class="triage-box ignore">
        <span>Ignore</span>
        <strong>{{ summary.ignore or 0 }}</strong>
      </div>
      <div class="triage-box regime">
        <span>Market Regime</span>
        <strong>{{ payload.regime or "Neutral" }}</strong>
      </div>
    </section>

    <section class="pulse-section" aria-label="JP market pulse">
      <div class="section-heading">
        <div class="kicker">JP MARKET PULSE</div>
        <h2>Market regime before individual signals.</h2>
      </div>

      <div class="pulse-grid">
        {% for pulse in market_pulse %}
          <article class="pulse-card">
            <div class="pulse-top">
              <div>
                <div class="pulse-label">{{ pulse.label }}</div>
                <div class="pulse-regime">{{ pulse.regime }}</div>
              </div>
              <div class="pulse-score">
                {{ pulse.pulse_score_0_100 | fmt_score }}
                <span>pulse</span>
              </div>
            </div>

            <div class="pulse-metrics">
              <div>
                <span>1D</span>
                <strong class="{{ pulse.return_1d_class }}">{{ pulse.return_1d_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>5D</span>
                <strong class="{{ pulse.return_5d_class }}">{{ pulse.return_5d_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>20D</span>
                <strong class="{{ pulse.return_20d_class }}">{{ pulse.return_20d_pct | fmt_pct }}</strong>
              </div>
            </div>
          </article>
        {% else %}
          <article class="empty-card">
            Market pulse data is not available yet.
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="ranking-section">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">DAILY SIGNALS</div>
          <h2>Ranked by event quality, not simple momentum.</h2>
        </div>
        <div class="method-chip">News excluded · Price / Volume / Timing only</div>
      </div>

      <div class="cards">
        {% for item in top_items %}
          <article class="signal-card {{ item.score_class }} triage-card-{{ (item.triage or 'unknown') | lower }}">
            <div class="card-top">
              <div class="rank">#{{ item.rank }}</div>

              <div class="score">
                {% if item.score_pts %}
                  {{ item.score_pts }}
                  <span>pts</span>
                {% else %}
                  {{ item.score | fmt_score }}
                  <span>score</span>
                {% endif %}
              </div>
            </div>

            <div class="signal-tags">
              <span class="tag triage-{{ (item.triage or 'unknown') | lower }}">
                {{ item.triage or "—" }}
              </span>
              <span class="tag">{{ item.archetype or "Mixed" }}</span>
              <span class="tag risk-{{ (item.risk_level or 'unknown') | lower }}">
                Risk: {{ item.risk_level or "—" }}
              </span>
            </div>

            <div class="symbol-row">
              <h3>{{ item.symbol }}</h3>
              <span class="bucket">{{ item.bucket }}</span>
            </div>

            <div class="name">{{ item.name }}</div>
            <div class="theme">{{ item.theme }}</div>

            <div class="classification">
              {{ item.classification }}
            </div>

            {% if item.reason %}
              <div class="reason">
                {{ item.reason }}
              </div>
            {% endif %}

            <div class="metric-grid">
              <div>
                <span>1D</span>
                <strong class="{{ item.return_1d_class }}">{{ item.return_1d_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>5D</span>
                <strong class="{{ item.return_5d_class }}">{{ item.return_5d_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>20D</span>
                <strong class="{{ item.return_20d_class }}">{{ item.return_20d_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>RVOL</span>
                <strong>{{ item.volume_ratio_20d | fmt_score }}</strong>
              </div>
              <div>
                <span>Avg Value</span>
                <strong>{{ item.avg_traded_value_20d_jpy | fmt_jpy }}</strong>
              </div>
              <div>
                <span>52W High</span>
                <strong>{{ item.distance_from_52w_high_pct | fmt_pct }}</strong>
              </div>
            </div>

            <div class="component-bars">
              <div>
                <span>Volume</span>
                <i style="width: {{ (item.v2_components.volume_liquidity_shock * 100) | round(0) if item.v2_components else (item.components.volume_shock / 24 * 100) | round(0) }}%"></i>
              </div>
              <div>
                <span>Compression</span>
                <i style="width: {{ (item.v2_components.compression_release * 100) | round(0) if item.v2_components else (item.components.compression / 22 * 100) | round(0) }}%"></i>
              </div>
              <div>
                <span>Breakout</span>
                <i style="width: {{ (item.v2_components.breakout_setup_quality * 100) | round(0) if item.v2_components else (item.components.breakout_quality / 20 * 100) | round(0) }}%"></i>
              </div>
              <div>
                <span>RS</span>
                <i style="width: {{ (item.v2_components.relative_strength * 100) | round(0) if item.v2_components else (item.components.relative_strength / 16 * 100) | round(0) }}%"></i>
              </div>
              <div>
                <span>Entry</span>
                <i style="width: {{ (item.v2_components.entry_timing * 100) | round(0) if item.v2_components else (item.components.entry_timing / 15 * 100) | round(0) }}%"></i>
              </div>
            </div>

            <div class="flags">
              {% for flag in item.flags[:7] %}
                <span>{{ flag.replace("_", " ") }}</span>
              {% endfor %}
            </div>

            <div class="risk-row">
              <span>{{ item.source }}</span>
              <span>{{ item.latest_date or item.as_of }}</span>
            </div>
          </article>
        {% else %}
          <article class="empty-card">
            No Daily signals have been generated yet.
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="table-section">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">FULL RANKING</div>
          <h2>All scored JP equities.</h2>
        </div>
        <div class="method-chip">Score is capped by liquidity, extension and confirmation rules</div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Rank</th>
              <th>Triage</th>
              <th>Symbol</th>
              <th>Name</th>
              <th>Bucket</th>
              <th>Score</th>
              <th>Archetype</th>
              <th>Class</th>
              <th>1D</th>
              <th>5D</th>
              <th>20D</th>
              <th>RVOL</th>
              <th>Avg Value</th>
              <th>Risk</th>
            </tr>
          </thead>
          <tbody>
            {% for item in items %}
              <tr>
                <td>#{{ item.rank }}</td>
                <td>
                  <span class="mini-tag triage-{{ (item.triage or 'unknown') | lower }}">
                    {{ item.triage or "—" }}
                  </span>
                </td>
                <td><strong>{{ item.symbol }}</strong></td>
                <td>{{ item.name }}</td>
                <td>{{ item.bucket }}</td>
                <td>
                  {% if item.score_pts %}
                    {{ item.score_pts }}
                  {% else %}
                    {{ item.score | fmt_score }}
                  {% endif %}
                </td>
                <td>{{ item.archetype or "Mixed" }}</td>
                <td>{{ item.classification }}</td>
                <td class="{{ item.return_1d_class }}">{{ item.return_1d_pct | fmt_pct }}</td>
                <td class="{{ item.return_5d_class }}">{{ item.return_5d_pct | fmt_pct }}</td>
                <td class="{{ item.return_20d_class }}">{{ item.return_20d_pct | fmt_pct }}</td>
                <td>{{ item.volume_ratio_20d | fmt_score }}</td>
                <td>{{ item.avg_traded_value_20d_jpy | fmt_jpy }}</td>
                <td class="{{ item.risk_class }}">{{ item.risk_level }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="method-section">
      <div class="method-card">
        <div class="kicker">METHODOLOGY</div>
        <h2>Daily Event Score v2</h2>
        <p>
          This model is designed to avoid a simple “strong stock” ranking. It prioritizes
          names showing event-like timing: volume/liquidity shock, compression release,
          breakout setup quality, relative strength versus TOPIX and entry discipline.
        </p>

        <div class="method-grid">
          <div>
            <span>Volume / Liquidity</span>
            <strong>24%</strong>
          </div>
          <div>
            <span>Compression Release</span>
            <strong>22%</strong>
          </div>
          <div>
            <span>Breakout Setup</span>
            <strong>20%</strong>
          </div>
          <div>
            <span>Relative Strength</span>
            <strong>16%</strong>
          </div>
          <div>
            <span>Entry Timing</span>
            <strong>15%</strong>
          </div>
          <div>
            <span>Market Regime</span>
            <strong>3%</strong>
          </div>
        </div>
      </div>

      <div class="method-card warning">
        <div class="kicker">CONTROLS</div>
        <h2>Why some high-momentum names are capped.</h2>
        <p>
          Low liquidity, no daily confirmation, weak close on volume and extended 5D/20D
          moves cap the final score. This keeps speculative discovery names visible
          without letting them dominate the Trade list.
        </p>
      </div>
    </section>

    <section class="notes">
      <strong>Not investment advice.</strong>
      <span>
        Daily v2 excludes news, disclosures and fundamentals. It is a price/volume/timing
        signal layer only. Small-cap and low-liquidity stocks can move violently.
      </span>
    </section>

    <footer class="footer">
      <span>Informational only. Not investment advice.</span>
      <nav>
        <a href="/">Home</a>
        <a href="/privacy/">Privacy</a>
        <a href="/disclaimer/">Disclaimer</a>
      </nav>
    </footer>
  </main>
</div>
</body>
</html>
