<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Japan Daily Signals | Neon Tokyo Signals</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Daily Japan equity momentum signals for global investors."/>
  <link rel="stylesheet" href="/assets/daily_jp.css?v=prototype-001"/>
</head>
<body>
<div class="page"><div class="ambient ambient-a"></div><div class="ambient ambient-b"></div><div class="grid"></div>
<main class="wrap">
  <nav class="top-nav">
    <a class="brand" href="/"><strong>NEON TOKYO SIGNALS</strong><span>Daily Japan equity signals</span></a>
    <div class="top-links"><a href="/">Home</a><a href="/japan/weekly/">Weekly</a><a href="/disclaimer/">Disclaimer</a></div>
  </nav>

  <section class="market-panel">
    <div class="pulse-stage" style="min-height:320px">
      <div class="pulse-bg-grid"></div><div class="pulse-bg-word" data-text="DAILY">DAILY</div><div class="pulse-scan"></div>
      <div class="hero-content"><div class="kicker">Japan Daily Signals</div><h1>DAILY<br/>SIGNALS</h1><p>As of {{ daily.date }}. Prototype ranking using sample data.</p></div>
    </div>
  </section>

  <section class="reaction-panel">
    <div class="section-head"><div class="nav-kicker">Top setups</div><h2>Daily Momentum List</h2></div>
    {% for item in items %}
    <div class="ticker-row">
      <div>
        <strong>#{{ item.rank }} {{ item.symbol }}</strong>
        <span>{{ item.name }} · {{ item.theme }} · {{ item.classification }} · {{ item.score | int }} pts</span>
        <span>{{ item.why_now }}</span>
      </div>
      <div class="reaction-buttons">
        <button type="button">Bullish {{ item.reactions.bullish | default(0) }}</button>
        <button type="button">Watching {{ item.reactions.watching | default(0) }}</button>
        <button type="button">Breakout {{ item.reactions.breakout | default(0) }}</button>
        <button type="button">Extended {{ item.reactions.extended | default(0) }}</button>
      </div>
    </div>
    {% endfor %}
  </section>
  <footer class="footer">Generated at {{ generated_at }} · Informational only. Not investment advice.</footer>
</main></div>
</body>
</html>
