<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Daily Japan Signals | Neon Tokyo Signals</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Daily Japan equity signals after the Tokyo close. Top 20 short-term trading candidates ranked by volume shock, compression release, breakout quality, relative strength and entry discipline."/>
  <meta name="theme-color" content="#050711"/>
  <link rel="stylesheet" href="/assets/daily_jp.css?v={{ asset_version }}"/>
</head>

<body>
<div class="page">
  <div class="ambient ambient-a"></div>
  <div class="ambient ambient-b"></div>
  <div class="grid"></div>

  <main class="wrap">
    <header class="header">
      <a class="brand" href="/">
        <span class="brand-mark">NTS</span>
        <span>
          <strong>NEON TOKYO SIGNALS</strong>
          <em>Japan equity signals after the Tokyo close.</em>
        </span>
      </a>

      <nav class="nav">
        <a href="/">Home</a>
        <a href="/japan/daily/" class="active">Daily</a>
        <a href="/japan/daily/backtest/">Backtest</a>
        <a href="/japan/weekly/">Weekly</a>
        <a href="/disclaimer/">Disclaimer</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <div class="kicker">
          <span class="live-dot"></span>
          DAILY JP EVENT SCORE V2 · TOP 20 MAIN BOARD
        </div>

        <h1>
          Tokyo close signals,
          <span>screened for short-term edge.</span>
        </h1>

        <p>
          The Daily board focuses on the top {{ main_rank_limit }} ranked candidates only.
          Rank 21–50 is treated as reference, not the core Daily signal set. News is
          intentionally excluded; this is a price, volume, liquidity and timing layer.
        </p>
      </div>

      <aside class="summary-card">
        <div class="summary-label">TOP SIGNAL</div>

        {% if summary.top_symbol %}
          <div class="summary-symbol">{{ summary.top_symbol }}</div>
          <div class="summary-name">{{ summary.top_name }}</div>

          <div class="summary-score">
            {% if summary.top_score_pts %}
              {{ summary.top_score_pts }}
              <span>pts / {{ summary.top_score | fmt_score }} score</span>
            {% else %}
              {{ summary.top_score | fmt_score }}
              <span>score</span>
            {% endif %}
          </div>

          <div class="summary-tags">
            <span class="tag triage-{{ (summary.top_triage or 'Unknown') | lower }}">
              {{ summary.top_triage or "—" }}
            </span>
            <span class="tag">{{ summary.top_archetype or "Mixed" }}</span>
            <span class="tag">{{ summary.top_classification or "No Signal" }}</span>
          </div>
        {% else %}
          <div class="summary-symbol">NO DATA</div>
          <div class="summary-name">Daily signal JSON has not been generated yet.</div>
        {% endif %}
      </aside>
    </section>

    <section class="meta-strip">
      <div>
        <span>Generated</span>
        <strong>{{ generated_at or "—" }}</strong>
      </div>
      <div>
        <span>Price Data</span>
        <strong>{{ source_prices_generated_at or "—" }}</strong>
      </div>
      <div>
        <span>Regime</span>
        <strong>{{ payload.regime or "—" }}</strong>
      </div>
      <div>
        <span>Universe</span>
        <strong>{{ summary.items_count or all_items|length }} names</strong>
      </div>
    </section>

    <section class="triage-strip" aria-label="Triage summary">
      <div class="triage-box trade">
        <span>Trade</span>
        <strong>{{ setup_quality.trade_count }}</strong>
        <em>Main Top {{ main_rank_limit }}</em>
      </div>
      <div class="triage-box watch">
        <span>Watch</span>
        <strong>{{ setup_quality.watch_count }}</strong>
        <em>Main Top {{ main_rank_limit }}</em>
      </div>
      <div class="triage-box ignore">
        <span>Ignore</span>
        <strong>{{ setup_quality.ignore_count }}</strong>
        <em>Main Top {{ main_rank_limit }}</em>
      </div>
      <div class="triage-box regime">
        <span>Market Regime</span>
        <strong>{{ payload.regime or "Neutral" }}</strong>
        <em>Tokyo close context</em>
      </div>
    </section>

    <section class="quality-map" aria-label="Daily signal quality map">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">SETUP QUALITY MAP</div>
          <h2>What matters today.</h2>
        </div>
        <div class="method-chip">Primary board: Rank 1–{{ main_rank_limit }} · Reference: Rank {{ main_rank_limit + 1 }}–{{ reference_limit }}</div>
      </div>

      <div class="quality-grid">
        <article class="quality-card good">
          <span>Favored Setups</span>
          <strong>{{ setup_quality.favored_count }}</strong>
          <p>Relative Strength, Compression + Breakout, or Volume + Compression with no major bad-flow flag.</p>
        </article>
        <article class="quality-card danger">
          <span>Risk Flags</span>
          <strong>{{ setup_quality.risk_count }}</strong>
          <p>Volume breakout risk, abnormal distribution, volume noise, weak close, or cap warnings.</p>
        </article>
        <article class="quality-card main">
          <span>Main Board</span>
          <strong>{{ setup_quality.main_count }}</strong>
          <p>Top {{ main_rank_limit }} names shown as the Daily decision set.</p>
        </article>
        <article class="quality-card ref">
          <span>Reference</span>
          <strong>{{ setup_quality.reference_count }}</strong>
          <p>Rank {{ main_rank_limit + 1 }}–{{ reference_limit }} is intentionally de-emphasized.</p>
        </article>
      </div>
    </section>

    <section class="pulse-section" aria-label="JP market pulse">
      <div class="section-heading">
        <div class="kicker">JP MARKET PULSE</div>
        <h2>Market regime before individual signals.</h2>
      </div>

      <div class="pulse-grid">
        {% for pulse in market_pulse %}
          <article class="pulse-card">
            <div class="pulse-top">
              <div>
                <div class="pulse-label">{{ pulse.label }}</div>
                <div class="pulse-regime">{{ pulse.regime }}</div>
              </div>
              <div class="pulse-score">
                {{ pulse.pulse_score_0_100 | fmt_score }}
                <span>pulse</span>
              </div>
            </div>

            <div class="pulse-metrics">
              <div>
                <span>1D</span>
                <strong class="{{ pulse.return_1d_class }}">{{ pulse.return_1d_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>5D</span>
                <strong class="{{ pulse.return_5d_class }}">{{ pulse.return_5d_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>20D</span>
                <strong class="{{ pulse.return_20d_class }}">{{ pulse.return_20d_pct | fmt_pct }}</strong>
              </div>
            </div>
          </article>
        {% else %}
          <article class="empty-card">Market pulse data is not available yet.</article>
        {% endfor %}
      </div>
    </section>

    <section class="ranking-section">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">MAIN DAILY BOARD</div>
          <h2>Top {{ main_rank_limit }} candidates, not a broad watchlist.</h2>
        </div>
        <div class="method-chip">5D short-term model · News excluded</div>
      </div>

      <div class="cards">
        {% for item in main_items %}
          <article class="signal-card {{ item.score_class }} triage-card-{{ (item.triage or 'unknown') | lower }}{% if item.has_risk_flag %} has-risk{% endif %}{% if item.has_good_setup %} has-good{% endif %}">
            <div class="card-top">
              <div class="rank">#{{ item.rank }}</div>
              <div class="score">
                {% if item.score_pts %}{{ item.score_pts }}<span>pts</span>{% else %}{{ item.score | fmt_score }}<span>score</span>{% endif %}
              </div>
            </div>

            <div class="signal-tags">
              <span class="tag triage-{{ (item.triage or 'unknown') | lower }}">{{ item.triage or "—" }}</span>
              <span class="tag">{{ item.archetype or "Mixed" }}</span>
              <span class="tag {{ item.liquidity_class }}">{{ item.liquidity_band }}</span>
              <span class="tag risk-{{ (item.risk_level or 'unknown') | lower }}">Risk: {{ item.risk_level or "—" }}</span>
            </div>

            {% if item.has_good_setup or item.has_risk_flag %}
              <div class="signal-diagnostics">
                {% if item.has_good_setup %}
                  <span class="diag good">{{ item.good_flag_label }}</span>
                {% endif %}
                {% if item.has_risk_flag %}
                  <span class="diag danger">{{ item.risk_flag_label }}</span>
                {% endif %}
              </div>
            {% endif %}

            <div class="symbol-row">
              <h3>{{ item.symbol }}</h3>
              <span class="bucket">{{ item.bucket }}</span>
            </div>

            <div class="name">{{ item.name }}</div>
            <div class="theme">{{ item.theme }}</div>

            <div class="classification">{{ item.classification }}</div>

            {% if item.reason_short %}
              <div class="reason">{{ item.reason_short }}</div>
            {% endif %}

            <div class="metric-grid">
              <div>
                <span>1D</span>
                <strong class="{{ item.return_1d_class }}">{{ item.return_1d_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>5D</span>
                <strong class="{{ item.return_5d_class }}">{{ item.return_5d_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>20D Ref</span>
                <strong class="{{ item.return_20d_class }}">{{ item.return_20d_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>RVOL</span>
                <strong>{{ item.volume_ratio_20d | fmt_score }}</strong>
              </div>
              <div>
                <span>Avg Value</span>
                <strong>{{ item.avg_traded_value_20d_jpy | fmt_jpy }}</strong>
              </div>
              <div>
                <span>52W High</span>
                <strong>{{ item.distance_from_52w_high_pct | fmt_pct }}</strong>
              </div>
            </div>

            <div class="component-bars">
              <div><span>Volume</span><i style="width: {{ item.component_widths.volume }}%"></i></div>
              <div><span>Compression</span><i style="width: {{ item.component_widths.compression }}%"></i></div>
              <div><span>Breakout</span><i style="width: {{ item.component_widths.breakout }}%"></i></div>
              <div><span>RS</span><i style="width: {{ item.component_widths.rs }}%"></i></div>
              <div><span>Entry</span><i style="width: {{ item.component_widths.entry }}%"></i></div>
            </div>

            <div class="flags">
              {% for flag in item.good_flags[:3] %}<span class="good">{{ flag | flag_label }}</span>{% endfor %}
              {% for flag in item.risk_flags[:3] %}<span class="danger">{{ flag | flag_label }}</span>{% endfor %}
              {% for flag in item.neutral_flags[:4] %}<span>{{ flag | flag_label }}</span>{% endfor %}
            </div>

            <div class="risk-row">
              <span>{{ item.source }}</span>
              <span>{{ item.latest_date or item.as_of }}</span>
            </div>
          </article>
        {% else %}
          <article class="empty-card">No Daily signals have been generated yet.</article>
        {% endfor %}
      </div>
    </section>

    <section class="insight-lanes">
      <div class="lane-card favored">
        <div class="section-heading compact">
          <div class="kicker">FAVORED SETUPS</div>
          <h2>Good technical structure inside Top {{ main_rank_limit }}.</h2>
        </div>
        <div class="mini-list">
          {% for item in favored_items %}
            <div class="mini-row">
              <strong>#{{ item.rank }} {{ item.symbol }}</strong>
              <span>{{ item.good_flag_label }}</span>
              <em>{{ item.triage }} · {{ item.score_pts }} pts</em>
            </div>
          {% else %}
            <div class="mini-empty">No favored setup flags in the main board today.</div>
          {% endfor %}
        </div>
      </div>

      <div class="lane-card warning">
        <div class="section-heading compact">
          <div class="kicker">RISK WARNINGS</div>
          <h2>Patterns the backtest says to distrust.</h2>
        </div>
        <div class="mini-list">
          {% for item in risk_items %}
            <div class="mini-row danger">
              <strong>#{{ item.rank }} {{ item.symbol }}</strong>
              <span>{{ item.risk_flag_label }}</span>
              <em>{{ item.triage }} · {{ item.score_pts }} pts</em>
            </div>
          {% else %}
            <div class="mini-empty">No major risk flags in the main board today.</div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="table-section">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">MAIN RANKING TABLE</div>
          <h2>Top {{ main_rank_limit }} scored JP equities.</h2>
        </div>
        <div class="method-chip">Risk flags are shown explicitly</div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Rank</th>
              <th>Triage</th>
              <th>Symbol</th>
              <th>Name</th>
              <th>Score</th>
              <th>Archetype</th>
              <th>Quality</th>
              <th>Liquidity</th>
              <th>1D</th>
              <th>5D</th>
              <th>20D Ref</th>
              <th>RVOL</th>
              <th>Avg Value</th>
              <th>Risk</th>
            </tr>
          </thead>
          <tbody>
            {% for item in main_items %}
              <tr class="{% if item.has_risk_flag %}row-risk{% elif item.has_good_setup %}row-good{% endif %}">
                <td>#{{ item.rank }}</td>
                <td><span class="mini-tag triage-{{ (item.triage or 'unknown') | lower }}">{{ item.triage or "—" }}</span></td>
                <td><strong>{{ item.symbol }}</strong></td>
                <td>{{ item.name }}</td>
                <td>{% if item.score_pts %}{{ item.score_pts }}{% else %}{{ item.score | fmt_score }}{% endif %}</td>
                <td>{{ item.archetype or "Mixed" }}</td>
                <td>
                  {% if item.has_risk_flag %}<span class="mini-tag danger">{{ item.risk_flag_label }}</span>
                  {% elif item.has_good_setup %}<span class="mini-tag good">{{ item.good_flag_label }}</span>
                  {% else %}<span class="mini-tag">neutral</span>{% endif %}
                </td>
                <td><span class="mini-tag {{ item.liquidity_class }}">{{ item.liquidity_band }}</span></td>
                <td class="{{ item.return_1d_class }}">{{ item.return_1d_pct | fmt_pct }}</td>
                <td class="{{ item.return_5d_class }}">{{ item.return_5d_pct | fmt_pct }}</td>
                <td class="{{ item.return_20d_class }}">{{ item.return_20d_pct | fmt_pct }}</td>
                <td>{{ item.volume_ratio_20d | fmt_score }}</td>
                <td>{{ item.avg_traded_value_20d_jpy | fmt_jpy }}</td>
                <td class="{{ item.risk_class }}">{{ item.risk_level }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="reference-section">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">REFERENCE ONLY</div>
          <h2>Rank {{ main_rank_limit + 1 }}–{{ reference_limit }} is not the Daily core.</h2>
        </div>
        <div class="method-chip">Backtest showed quality decay after Rank 20</div>
      </div>
      <div class="reference-grid">
        {% for item in reference_items[:12] %}
          <div class="reference-pill{% if item.has_risk_flag %} risk{% elif item.has_good_setup %} good{% endif %}">
            <strong>#{{ item.rank }} {{ item.symbol }}</strong>
            <span>{{ item.triage }} · {{ item.score_pts }} pts · {{ item.archetype }}</span>
          </div>
        {% else %}
          <div class="empty-card">No reference names available.</div>
        {% endfor %}
      </div>
    </section>

    <section class="method-section">
      <div class="method-card">
        <div class="kicker">METHODOLOGY</div>
        <h2>Daily Event Score v2</h2>
        <p>
          The Daily model is a short-term trading screen. It prioritizes 1D/3D/5D/10D behavior,
          with 5D as the primary backtest horizon. 20D is shown as a reference horizon only.
        </p>

        <div class="method-grid">
          <div><span>Volume / Liquidity</span><strong>24%</strong></div>
          <div><span>Compression Release</span><strong>22%</strong></div>
          <div><span>Breakout Setup</span><strong>20%</strong></div>
          <div><span>Relative Strength</span><strong>16%</strong></div>
          <div><span>Entry Timing</span><strong>15%</strong></div>
          <div><span>Market Regime</span><strong>3%</strong></div>
        </div>
      </div>

      <div class="method-card warning">
        <div class="kicker">CONTROLS</div>
        <h2>What the latest backtest changed.</h2>
        <p>
          Volume + Breakout without compression is treated as exhaustion risk. Relative Strength,
          Compression + Breakout, and Volume + Compression are favored. Abnormal distribution and
          volume noise are penalized. Rank 21–50 is reference, not the main Daily decision board.
        </p>
      </div>
    </section>

    <section class="notes">
      <strong>Not investment advice.</strong>
      <span>
        Daily v2 excludes news, disclosures and fundamentals. It is a price/volume/timing
        signal layer only. Small-cap and low-liquidity stocks can move violently.
      </span>
    </section>

    <footer class="footer">
      <span>Informational only. Not investment advice.</span>
      <nav>
        <a href="/">Home</a>
        <a href="/privacy/">Privacy</a>
        <a href="/disclaimer/">Disclaimer</a>
      </nav>
    </footer>
  </main>
</div>
</body>
</html>
