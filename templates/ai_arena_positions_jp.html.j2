<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AI Arena Positions | Neon Tokyo Signals</title>
  <meta name="description" content="Current holdings and closed trades for the seven Neon Tokyo AI Arena agents." />
  <link rel="stylesheet" href="/assets/ai_arena_positions_jp.css" />
</head>
<body>
  <main class="arena-shell">
    <nav class="arena-nav" aria-label="AI Arena navigation">
      <a href="/">TOP</a>
      <a href="/japan/ai-arena/summary/">SUMMARY</a>
      <a href="/japan/ai-arena/ranking/">RANKING</a>
      <a class="active" href="/japan/ai-arena/positions/">POSITIONS</a>
      <a href="/japan/ai-arena/agents/">AGENTS</a>
    </nav>

    <header class="hero-panel">
      <section>
        <p class="eyebrow">NEON TOKYO // AI ARENA JP</p>
        <h1>Seven-Agent Position Book</h1>
        <p class="lead">Current holdings and recent closed trades generated from the latest display run.</p>
        <div class="run-meta">
          <span>RUN <b>{{ payload.run_id or 'N/A' }}</b></span>
          <span>YEAR <b>{{ payload.year or 'N/A' }}</b></span>
          <span>UPDATED <b>{{ payload.generated_at or 'N/A' }}</b></span>
        </div>
      </section>
      <aside class="league-kpis">
        <article><span>Agents</span><b>{{ payload.agent_count }}</b></article>
        <article><span>Open</span><b>{{ payload.history.open_count }}</b></article>
        <article><span>Open MV</span><b>{{ payload.history.total_open_value_fmt }}</b></article>
        <article><span>Closed</span><b>{{ payload.history.closed_count }}</b></article>
      </aside>
    </header>

    <section class="book-summary">
      <article><span>Unrealized P/L</span><b class="{{ payload.history.total_unrealized_class }}">{{ payload.history.total_unrealized_fmt }}</b></article>
      <article><span>Realized P/L</span><b class="{{ payload.history.total_realized_class }}">{{ payload.history.total_realized_fmt }}</b></article>
      <article><span>Closed Win Rate</span><b>{{ payload.history.win_rate_fmt }}</b></article>
    </section>

    {% for agent in payload.agents %}
    <section class="agent-book" style="--agent-color: {{ agent.color }}">
      <header class="agent-head">
        <div class="agent-id">
          {% if agent.image %}<img src="{{ agent.image }}" alt="{{ agent.name }} avatar" loading="lazy" />{% endif %}
          <div>
            <p class="eyebrow">#{{ agent.rank }} // {{ agent.role }}</p>
            <h2>{{ agent.name }}</h2>
            <p>{{ agent.description }}</p>
          </div>
        </div>
        <div class="agent-score">
          <span>Total Return</span>
          <b>{{ agent.return_fmt }}</b>
          <small>{{ agent.equity_fmt }}</small>
        </div>
      </header>

      <div class="agent-kpis">
        <article><span>Open</span><b>{{ agent.open_count }}</b></article>
        <article><span>Closed</span><b>{{ agent.closed_count }}</b></article>
        <article><span>Unrealized</span><b class="{{ agent.unrealized_class }}">{{ agent.unrealized_pnl_fmt }}</b></article>
        <article><span>Realized</span><b class="{{ agent.realized_class }}">{{ agent.realized_pnl_fmt }}</b></article>
        <article><span>Win Rate</span><b>{{ agent.win_rate_fmt }}</b></article>
        <article><span>Signals</span><b>{{ agent.trade_signals }}</b></article>
      </div>

      <div class="split-grid">
        <article class="panel">
          <div class="panel-head"><h3>Current Holdings</h3><span>{{ agent.open_count }} position{{ '' if agent.open_count == 1 else 's' }}</span></div>
          <div class="position-list">
            {% for p in agent.open_positions %}
            <div class="position-row {{ p.pnl_class }}">
              <div><b>{{ p.ticker }}</b><span>{{ p.name }}</span></div>
              <strong>{{ p.unrealized_return_fmt }}</strong>
              <small>{{ p.market_value_fmt }}</small>
              <em>{{ p.unrealized_pnl_fmt }}</em>
            </div>
            {% else %}<div class="empty-state">No active position. This agent is holding cash.</div>{% endfor %}
          </div>
        </article>

        <article class="panel">
          <div class="panel-head"><h3>Recent Closed Trades</h3><span>{{ agent.recent_closed_trades|length }} shown</span></div>
          <div class="trade-list">
            {% for t in agent.recent_closed_trades %}
            <div class="trade-row {{ t.pnl_class }}">
              <div><b>{{ t.ticker }}</b><span>{{ t.name }}</span></div>
              <strong>{{ t.return_fmt }}</strong>
              <small>{{ t.entry_date_fmt }} → {{ t.exit_date_fmt }}</small>
              <em>{{ t.pnl_fmt }}</em>
            </div>
            {% else %}<div class="empty-state">No closed trade yet.</div>{% endfor %}
          </div>
        </article>
      </div>
    </section>
    {% else %}
    <section class="empty-state big">No seven-agent position book was exported. Run AI Arena JP season rebuild.</section>
    {% endfor %}

    <section class="global-tape">
      <header><p class="eyebrow">GLOBAL TAPE</p><h2>Recent Closed Trades</h2></header>
      <div class="global-list">
        {% for t in payload.history.recent_closed_trades %}
        <div class="global-row {{ t.pnl_class }}" style="--agent-color: {{ t.color or '#7DF9FF' }}">
          <span>{{ t.agent_name }}</span><b>{{ t.ticker }}</b><small>{{ t.name }}</small><em>{{ t.return_fmt }}</em><strong>{{ t.pnl_fmt }}</strong>
        </div>
        {% else %}<div class="empty-state">No closed trades found.</div>{% endfor %}
      </div>
    </section>
  </main>
</body>
</html>
