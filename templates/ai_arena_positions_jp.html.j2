<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AI Arena Positions</title><link rel="stylesheet" href="/assets/ai_arena_positions_jp.css"></head><body><main class="page"><nav><a href="/">TOP</a><a href="/japan/ai-arena/">ARENA</a><a class="active" href="/japan/ai-arena/positions/">POSITIONS</a><a href="/japan/ai-arena/ranking/">RANKING</a></nav><header class="hero"><p>NEON TOKYO AI ARENA</p><h1>Agent Positions</h1><div class="meta"><span>Season {{ positions.season or '—' }}</span><span>{{ positions.range.start_date if positions.range else '—' }} → {{ positions.range.end_date if positions.range else '—' }}</span></div></header>{% for agent in positions.agents or [] %}<section class="agent"><div class="agent-head"><div><p class="eyebrow">{{ agent.class }}</p><h2>{{ agent.name }}</h2></div><div class="summary"><span>Return <b>{{ '%.2f'|format(agent.summary.return_pct or 0) }}%</b></span><span>Equity <b>¥{{ '{:,.0f}'.format(agent.summary.portfolio_equity_jpy or 0) }}</b></span><span>Cash <b>¥{{ '{:,.0f}'.format(agent.summary.cash_jpy or 0) }}</b></span></div></div><div class="positions">{% for p in agent.open_positions %}<article class="pos"><div class="pos-top"><b>{{ p.symbol }}</b><em>{{ '%.2f'|format(p.unrealized_return_pct or 0) }}%</em></div><h3>{{ p.name }}</h3><p>{{ p.theme }}</p><div class="grid"><span>Entry</span><b>{{ p.entry_date }}</b><span>Holding</span><b>{{ p.holding_days }}d</b><span>Shares</span><b>{{ p.shares }}</b><span>Value</span><b>¥{{ '{:,.0f}'.format(p.market_value_jpy or 0) }}</b></div><small>{{ p.entry_reason }}</small></article>{% else %}<article class="pos empty">No open positions. This agent is holding cash.</article>{% endfor %}</div></section>{% endfor %}</main></body></html>
