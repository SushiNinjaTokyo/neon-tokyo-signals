<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>JP Daily Backtest | Neon Tokyo Signals</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Backtest dashboard for Neon Tokyo Daily JP Event Score. Performance by triage, archetype, score band, liquidity and market regime."/>
  <meta name="theme-color" content="#050711"/>
  <link rel="stylesheet" href="/assets/backtest_daily_jp.css?v={{ asset_version }}"/>
</head>

<body>
<div class="page">
  <div class="ambient ambient-a"></div>
  <div class="ambient ambient-b"></div>
  <div class="grid"></div>

  <main class="wrap">
    <header class="header">
      <a class="brand" href="/">
        <span class="brand-mark">NTS</span>
        <span>
          <strong>NEON TOKYO SIGNALS</strong>
          <em>Japan equity signals after the Tokyo close.</em>
        </span>
      </a>

      <nav class="nav">
        <a href="/">Home</a>
        <a href="/japan/daily/">Daily</a>
        <a href="/japan/daily/backtest/" class="active">Backtest</a>
        <a href="/disclaimer/">Disclaimer</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <div class="kicker">
          <span class="live-dot"></span>
          JP DAILY BACKTEST LAB
        </div>

        <h1>
          Signal quality,
          <span>measured after the fact.</span>
        </h1>

        <p>
          Historical replay of the Daily Event Score v2 as a short-term trading model.
          The main evaluation range is 1D / 3D / 5D / 10D, with 5D as the primary horizon.
          20D is displayed only as a decay and durability reference.
        </p>
      </div>

      <aside class="summary-card">
        <div class="summary-label">BACKTEST RANGE</div>
        <div class="summary-main">
          {{ summary.eval_date_count or 0 }}
          <span>eval dates</span>
        </div>
        <div class="summary-sub">
          {{ summary.eval_date_start or "—" }} → {{ summary.eval_date_end or "—" }}
        </div>
        <div class="summary-meta">
          <span>{{ summary.signal_count or 0 }} signals</span>
          <span>{{ payload.mode or "—" }}</span>
        </div>
      </aside>
    </section>

    <section class="meta-strip">
      <div>
        <span>Generated</span>
        <strong>{{ generated_at or "—" }}</strong>
      </div>
      <div>
        <span>Price Data</span>
        <strong>{{ payload.source_prices_generated_at or "—" }}</strong>
      </div>
      <div>
        <span>Primary</span>
        <strong>{{ primary_horizon }}D</strong>
      </div>
      <div>
        <span>Core Range</span>
        <strong>{% for h in core_horizons %}{{ h }}D{% if not loop.last %} / {% endif %}{% endfor %}</strong>
      </div>
      <div>
        <span>Reference</span>
        <strong>{% for h in reference_horizons %}{{ h }}D{% if not loop.last %} / {% endif %}{% else %}—{% endfor %}</strong>
      </div>
      <div>
        <span>API Calls</span>
        <strong>0</strong>
      </div>
    </section>

    <section class="insight-grid">
      {% for insight in insights %}
        <article class="insight-card">
          <span>{{ insight.label }}</span>
          <strong class="{{ insight.class }}">{{ insight.value }}</strong>
          <em>{{ insight.detail }}</em>
        </article>
      {% endfor %}
    </section>


    <section class="section-block visual-block">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">VISUAL PERFORMANCE MAP</div>
          <h2>The model's edge at a glance.</h2>
          <p>
            These charts use the {{ visualization_view.primary_horizon }} primary horizon. Longer bars mean stronger alpha;
            red bars are negative. The goal is simple: Trade/Watch, high score, and top rank should be visibly better than weak buckets.
          </p>
        </div>
        <div class="method-chip">Primary {{ visualization_view.primary_horizon }}</div>
      </div>

      <div class="visual-grid two-col">
        <article class="chart-card">
          <div class="chart-title">
            <strong>Triage separation</strong>
            <span>Avg alpha by Trade / Watch / Ignore</span>
          </div>
          <div class="bar-list">
            {% for row in visualization_view.triage %}
              <div class="bar-row">
                <div class="bar-label"><strong>{{ row.label }}</strong><span>{{ row.count | fmt_int }} obs</span></div>
                <div class="bar-track"><div class="bar-fill {{ row.bar_class }}" style="width: {{ row.bar_width }}%"></div></div>
                <div class="bar-value {{ row.bar_class }}">{{ row.value | fmt_pct }}</div>
                <div class="bar-sub">Win {{ row.win_rate_pct | fmt_pct(1, False) }}</div>
              </div>
            {% endfor %}
          </div>
        </article>

        <article class="chart-card">
          <div class="chart-title">
            <strong>Rank quality</strong>
            <span>Top 20 is the main Daily board; 21-50 is reference.</span>
          </div>
          <div class="bar-list">
            {% for row in visualization_view.rank_buckets %}
              <div class="bar-row {% if '21-50' in row.label %}reference-row{% endif %}">
                <div class="bar-label"><strong>{{ row.label }}</strong><span>{{ row.count | fmt_int }} obs</span></div>
                <div class="bar-track"><div class="bar-fill {{ row.bar_class }}" style="width: {{ row.bar_width }}%"></div></div>
                <div class="bar-value {{ row.bar_class }}">{{ row.value | fmt_pct }}</div>
                <div class="bar-sub">Return {{ row.secondary_value | fmt_pct }}</div>
              </div>
            {% endfor %}
          </div>
        </article>
      </div>

      <div class="visual-grid two-col">
        <article class="chart-card">
          <div class="chart-title">
            <strong>Score bands</strong>
            <span>Checks whether higher scores create better alpha.</span>
          </div>
          <div class="bar-list compact-bars">
            {% for row in visualization_view.score_bands %}
              <div class="bar-row">
                <div class="bar-label"><strong>{{ row.label }}</strong><span>{{ row.count | fmt_int }} obs</span></div>
                <div class="bar-track"><div class="bar-fill {{ row.bar_class }}" style="width: {{ row.bar_width }}%"></div></div>
                <div class="bar-value {{ row.bar_class }}">{{ row.value | fmt_pct }}</div>
              </div>
            {% endfor %}
          </div>
        </article>

        <article class="chart-card">
          <div class="chart-title">
            <strong>Liquidity bands</strong>
            <span>Liquidity is checked after the bucket logic revision.</span>
          </div>
          <div class="bar-list compact-bars">
            {% for row in visualization_view.liquidity_bands %}
              <div class="bar-row">
                <div class="bar-label"><strong>{{ row.label }}</strong><span>{{ row.count | fmt_int }} obs</span></div>
                <div class="bar-track"><div class="bar-fill {{ row.bar_class }}" style="width: {{ row.bar_width }}%"></div></div>
                <div class="bar-value {{ row.bar_class }}">{{ row.value | fmt_pct }}</div>
              </div>
            {% endfor %}
          </div>
        </article>
      </div>

      <article class="chart-card wide-chart">
        <div class="chart-title">
          <strong>Best and worst signal archetypes</strong>
          <span>Favored structures should rise; Volume + Breakout risk should be contained.</span>
        </div>
        <div class="bar-list archetype-bars">
          {% for row in visualization_view.archetypes %}
            <div class="bar-row">
              <div class="bar-label"><strong>{{ row.label }}</strong><span>{{ row.count | fmt_int }} obs</span></div>
              <div class="bar-track"><div class="bar-fill {{ row.bar_class }}" style="width: {{ row.bar_width }}%"></div></div>
              <div class="bar-value {{ row.bar_class }}">{{ row.value | fmt_pct }}</div>
              <div class="bar-sub">Win {{ row.win_rate_pct | fmt_pct(1, False) }}</div>
            </div>
          {% endfor %}
        </div>
      </article>
    </section>


    <section class="section-block health-block">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">MODEL HEALTH</div>
          <h2>Before trusting the score, test the score.</h2>
          <p>
            This is the control panel for whether Daily v2 works as a short-term trading model:
            Trade/Watch must beat Ignore on the 5D primary horizon and across the 1D / 3D / 5D / 10D core range.
            20D is not used as the main pass/fail target.
          </p>
        </div>
        <div class="status-pill {{ model_health.raw.verdict | lower }}">{{ model_health.raw.verdict or "Insufficient" }}</div>
      </div>

      <div class="health-grid">
        {% for card in model_health.cards %}
          <article class="health-card {{ card.class }}">
            <span>{{ card.label }}</span>
            <strong>{{ card.value }}</strong>
            <em>{{ card.detail }}</em>
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="section-block warning-block">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">BENCHMARK QUALITY</div>
          <h2>Alpha is only computed when TOPIX data is sane.</h2>
          <p>
            Raw stock returns stay in the backtest. If the TOPIX ETF benchmark shows an implausible future return,
            alpha is set to null for that date × horizon so benchmark data glitches cannot distort Model Health.
          </p>
        </div>
        <div class="method-chip {{ benchmark_quality_view.status_class }}">
          {{ benchmark_quality_view.raw.status or "—" }} / limit {{ benchmark_quality_view.raw.abs_return_limit_pct | fmt_pct(2, False) }}
        </div>
      </div>

      <div class="diagnostic-strip">
        <div>
          <span>Benchmark</span>
          <strong>{{ benchmark_quality_view.raw.benchmark_label or "TOPIX" }} / {{ benchmark_quality_view.raw.benchmark_symbol or "1306.T" }}</strong>
        </div>
        <div>
          <span>Invalid Horizon Obs</span>
          <strong>{{ benchmark_quality_view.raw.total_invalid_horizon_observations | fmt_int }}</strong>
        </div>
        <div>
          <span>Alpha Rule</span>
          <strong>Invalid → null</strong>
        </div>
        <div>
          <span>Raw Return</span>
          <strong>Always kept</strong>
        </div>
      </div>

      <div class="group-table-wrap">
        <table class="group-table compact-table">
          <thead>
            <tr>
              <th>Horizon</th>
              <th>Status</th>
              <th>Valid</th>
              <th>Invalid</th>
              <th>Valid Rate</th>
              <th>Min Benchmark Ret</th>
              <th>Max Benchmark Ret</th>
            </tr>
          </thead>
          <tbody>
            {% for row in benchmark_quality_view.rows %}
              <tr>
                <td><strong>{{ row.horizon }}</strong></td>
                <td><span class="method-chip {{ row.status_class }}">{{ row.status }}</span></td>
                <td>{{ row.valid_count | fmt_int }}</td>
                <td>{{ row.invalid_count | fmt_int }}</td>
                <td>{{ row.valid_rate_pct | fmt_pct(2, False) }}</td>
                <td>{{ row.min_benchmark_return_pct | fmt_pct }}</td>
                <td>{{ row.max_benchmark_return_pct | fmt_pct }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if benchmark_quality_view.invalid_samples %}
        <div class="warning-note">
          <strong>Invalid alpha samples:</strong>
          {% for sample in benchmark_quality_view.invalid_samples %}
            <span>{{ sample.eval_date }} {{ sample.horizon }} {{ sample.benchmark_return_pct | fmt_pct }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </section>

    <section class="section-block warning-block">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">OUTLIER ANALYSIS</div>
          <h2>Average-return distortion check.</h2>
          <p>
            Japanese small-cap signals can look excellent because of one explosive name. This section checks concentration on the Daily primary horizon, while 20D remains reference only.
          </p>
        </div>
        <div class="method-chip {{ outlier_view.status_class }}">
          {{ outlier_view.raw.average_return_distortion_warning or "—" }} / {{ outlier_view.raw.primary_horizon | upper }}
        </div>
      </div>

      <div class="diagnostic-strip">
        <div>
          <span>Avg Return</span>
          <strong class="{{ 'value-up' if outlier_view.raw.avg_return_pct and outlier_view.raw.avg_return_pct > 0 else 'value-down' if outlier_view.raw.avg_return_pct and outlier_view.raw.avg_return_pct < 0 else 'value-flat' }}">{{ outlier_view.raw.avg_return_pct | fmt_pct }}</strong>
        </div>
        <div>
          <span>Median Return</span>
          <strong>{{ outlier_view.raw.median_return_pct | fmt_pct }}</strong>
        </div>
        <div>
          <span>Avg - Median Gap</span>
          <strong>{{ outlier_view.raw.median_average_gap_pct | fmt_pct }}</strong>
        </div>
        <div>
          <span>Top Symbol Contribution</span>
          <strong>{{ outlier_view.raw.top_symbol_contribution_pct | fmt_pct(2, False) }}</strong>
        </div>
      </div>

      <div class="dual-table-grid">
        <div class="group-table-wrap">
          <table class="group-table compact-table">
            <thead>
              <tr>
                <th>Top Return Contributor</th>
                <th>Triage</th>
                <th>Score</th>
                <th>Return</th>
                <th>Alpha</th>
                <th>Contribution</th>
              </tr>
            </thead>
            <tbody>
              {% for row in outlier_view.contributors %}
                <tr>
                  <td>
                    <strong>{{ row.symbol }}</strong>
                    <span>{{ row.name }} / {{ row.eval_date }}</span>
                  </td>
                  <td><span class="mini-tag {{ row.triage_css }}">{{ row.triage }}</span></td>
                  <td>{{ row.score_pts }}</td>
                  <td class="{{ row.return_class }}">{{ row.return_pct | fmt_pct }}</td>
                  <td class="{{ row.alpha_class }}">{{ row.alpha_pct | fmt_pct }}</td>
                  <td>{{ row.positive_return_contribution_pct | fmt_pct(2, False) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="group-table-wrap">
          <table class="group-table compact-table">
            <thead>
              <tr>
                <th>Dominant Symbol</th>
                <th>Obs</th>
                <th>Avg</th>
                <th>Median</th>
                <th>Max</th>
                <th>Contribution</th>
              </tr>
            </thead>
            <tbody>
              {% for row in outlier_view.symbols %}
                <tr>
                  <td>
                    <strong>{{ row.symbol }}</strong>
                    <span>{{ row.name }}</span>
                  </td>
                  <td>{{ row.observations | fmt_int }}</td>
                  <td class="{{ row.return_class }}">{{ row.avg_return_pct | fmt_pct }}</td>
                  <td>{{ row.median_return_pct | fmt_pct }}</td>
                  <td>{{ row.max_return_pct | fmt_pct }}</td>
                  <td>{{ row.positive_return_contribution_pct | fmt_pct(2, False) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <div class="kicker">MODEL DIAGNOSTICS</div>
        <h2>Does the model beat its own rejects in the short-term range?</h2>
        <p>Core Daily checks are 1D / 3D / 5D / 10D, with 5D as primary. 20D is marked as reference and should be read as decay/durability, not the main Daily target.</p>
      </div>

      <div class="group-table-wrap">
        <table class="group-table">
          <thead>
            <tr>
              <th>Horizon</th>
              <th>Role</th>
              <th>Trade - Ignore Alpha</th>
              <th>Watch - Ignore Alpha</th>
              <th>Trade - Ignore Median Alpha</th>
              <th>Score Avg Alpha Mono</th>
              <th>Score Median Alpha Mono</th>
            </tr>
          </thead>
          <tbody>
            {% for row in diagnostic_rows %}
              <tr>
                <td><strong>{{ row.horizon }}</strong></td>
                <td><span class="role-pill {{ row.role_class }}">{{ row.role }}</span></td>
                <td class="{{ row.trade_class }}">{{ row.trade_minus_ignore_alpha_pct | fmt_pct }}</td>
                <td class="{{ row.watch_class }}">{{ row.watch_minus_ignore_alpha_pct | fmt_pct }}</td>
                <td class="{{ row.median_class }}">{{ row.trade_minus_ignore_median_alpha_pct | fmt_pct }}</td>
                <td><span class="health-tag {{ row.score_mono_class }}">{{ row.score_mono }}</span></td>
                <td><span class="health-tag {{ row.score_median_mono_class }}">{{ row.score_median_mono }}</span></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <div class="kicker">FILTERED PERFORMANCE</div>
        <h2>Return quality under stricter cuts.</h2>
        <p>Top-20 rank, triage, score threshold, liquidity, favored archetype and outlier controls. Read 1D / 3D / 5D / 10D as the main Daily range; 20D is reference.</p>
      </div>

      <div class="group-table-wrap wide-scroll">
        <table class="group-table dense-table">
          <thead>
            <tr>
              <th>Filter</th>
              {% for h in horizons %}
                <th>{{ h }}D Cnt</th>
                <th>{{ h }}D Avg</th>
                <th>{{ h }}D Med</th>
                <th>{{ h }}D Alpha</th>
                <th>{{ h }}D Win</th>
                <th>{{ h }}D Winsor</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for row in filtered_rows %}
              <tr>
                <td>
                  <strong>{{ row.label }}</strong>
                  <span>{{ row.description }}</span>
                </td>
                {% for cell in row.cells %}
                  <td>{{ cell.count | fmt_int }}</td>
                  <td class="{{ cell.avg_class }}">{{ cell.avg_return_pct | fmt_pct }}</td>
                  <td>{{ cell.median_return_pct | fmt_pct }}</td>
                  <td class="{{ cell.alpha_class }}">{{ cell.avg_alpha_pct | fmt_pct }}</td>
                  <td class="{{ cell.win_class }}">{{ cell.win_rate_pct | fmt_pct(2, False) }}</td>
                  <td>{{ cell.winsorized_avg_return_pct | fmt_pct }}</td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <div class="kicker">RANK BUCKET PERFORMANCE</div>
        <h2>Does rank order have signal?</h2>
        <p>Rank 1-20 is the main Daily board. Rank 21-50 is retained as a reference / discovery shelf, not the primary decision zone.</p>
      </div>

      <div class="group-table-wrap">
        <table class="group-table">
          <thead>
            <tr>
              <th>Rank Bucket</th>
              {% for h in horizons %}
                <th>{{ h }}D Avg</th>
                <th>{{ h }}D Median</th>
                <th>{{ h }}D Alpha</th>
                <th>{{ h }}D Win</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for row in rank_bucket_rows %}
              <tr>
                <td>
                  <strong>{{ row.label }}</strong>
                  <span>{{ row.count | fmt_int }} obs</span>
                </td>
                {% for cell in row.cells %}
                  <td class="{{ cell.avg_class }}">{{ cell.avg_return_pct | fmt_pct }}</td>
                  <td>{{ cell.median_return_pct | fmt_pct }}</td>
                  <td class="{{ cell.alpha_class }}">{{ cell.avg_alpha_pct | fmt_pct }}</td>
                  <td class="{{ cell.win_class }}">{{ cell.win_rate_pct | fmt_pct(2, False) }}</td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">REPEATED SYMBOL ANALYSIS</div>
          <h2>Observation-level vs symbol-level distortion.</h2>
          <p>Checks whether the same name repeatedly enters the sample and distorts the aggregate statistics.</p>
        </div>
        <div class="method-chip">
          Obs avg {{ repeated_symbol_view.raw.observation_level_avg_return_pct | fmt_pct }} / Symbol avg {{ repeated_symbol_view.raw.equal_weight_symbol_avg_return_pct | fmt_pct }}
        </div>
      </div>

      <div class="diagnostic-strip">
        <div>
          <span>Symbols</span>
          <strong>{{ repeated_symbol_view.raw.symbol_count | fmt_int }}</strong>
        </div>
        <div>
          <span>Obs</span>
          <strong>{{ repeated_symbol_view.raw.observation_count | fmt_int }}</strong>
        </div>
        <div>
          <span>Max Single Symbol Obs Share</span>
          <strong>{{ repeated_symbol_view.raw.max_symbol_observation_share_pct | fmt_pct(2, False) }}</strong>
        </div>
        <div>
          <span>Obs - Symbol Avg Gap</span>
          <strong>{{ repeated_symbol_view.raw.observation_vs_symbol_avg_gap_pct | fmt_pct }}</strong>
        </div>
      </div>

      <div class="group-table-wrap">
        <table class="group-table compact-table">
          <thead>
            <tr>
              <th>Symbol</th>
              <th>Obs</th>
              <th>Eval Dates</th>
              <th>Avg Return</th>
              <th>Median Return</th>
              <th>Avg Alpha</th>
              <th>Avg Score</th>
            </tr>
          </thead>
          <tbody>
            {% for row in repeated_symbol_view.rows %}
              <tr>
                <td>
                  <strong>{{ row.symbol }}</strong>
                  <span>{{ row.name }}</span>
                </td>
                <td>{{ row.observations | fmt_int }}</td>
                <td>{{ row.eval_date_count | fmt_int }}</td>
                <td class="{{ row.return_class }}">{{ row.avg_return_pct | fmt_pct }}</td>
                <td>{{ row.median_return_pct | fmt_pct }}</td>
                <td class="{{ row.alpha_class }}">{{ row.avg_alpha_pct | fmt_pct }}</td>
                <td>{{ row.avg_score_pts | fmt_num }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">OVERALL RESULT</div>
          <h2>Forward returns by holding horizon.</h2>
        </div>
        <div class="method-chip">Entry = evaluation date close</div>
      </div>

      <div class="horizon-grid">
        {% for row in overall_rows %}
          <article class="horizon-card">
            <div class="horizon-top">
              <span>{{ row.horizon }}</span>
              <strong>{{ row.count | fmt_int }}</strong>
            </div>

            <div class="big-return {{ row.avg_return_class }}">
              {{ row.avg_return_pct | fmt_pct }}
              <span>avg return</span>
            </div>

            <div class="horizon-metrics">
              <div>
                <span>Median</span>
                <strong class="{{ row.avg_return_class }}">{{ row.median_return_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>Win Rate</span>
                <strong class="{{ row.win_rate_class }}">{{ row.win_rate_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>Avg Alpha</span>
                <strong class="{{ row.avg_alpha_class }}">{{ row.avg_alpha_pct | fmt_pct }}</strong>
              </div>
              <div>
                <span>Worst PB</span>
                <strong>{{ row.avg_worst_pullback_pct | fmt_pct }}</strong>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    </section>

    {% for section in group_sections %}
      <section class="section-block">
        <div class="section-heading">
          <div class="kicker">{{ section.label | upper }}</div>
          <h2>{{ section.title }}</h2>
          <p>{{ section.subtitle }}</p>
        </div>

        <div class="group-table-wrap">
          <table class="group-table">
            <thead>
              <tr>
                <th>{{ section.label }}</th>
                {% for h in horizons %}
                  <th>{{ h }}D Avg</th>
                  <th>{{ h }}D Win</th>
                  <th>{{ h }}D Alpha</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in section.rows %}
                <tr>
                  <td>
                    <strong class="{{ row.name_class }}">{{ row.name }}</strong>
                    <span>{{ row.count | fmt_int }} obs</span>
                  </td>

                  {% for cell in row.cells %}
                    <td class="{{ cell.avg_return_class }}">{{ cell.avg_return_pct | fmt_pct }}</td>
                    <td class="{{ cell.win_rate_class }}">{{ cell.win_rate_pct | fmt_pct }}</td>
                    <td class="{{ cell.avg_alpha_class }}">{{ cell.avg_alpha_pct | fmt_pct }}</td>
                  {% endfor %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    {% endfor %}

    <section class="section-block">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">BEST FORWARD MOVES</div>
          <h2>Top realized returns.</h2>
        </div>
        <div class="method-chip">Primary horizon: {{ primary_horizon }}D short-term</div>
      </div>

      <div class="mini-card-grid">
        {% for row in top_return_rows %}
          <article class="mini-card">
            <div class="mini-top">
              <span>{{ row.eval_date }}</span>
              <strong class="{{ row.triage_css }}">{{ row.triage }}</strong>
            </div>

            <h3>{{ row.symbol }}</h3>
            <p>{{ row.name }}</p>

            <div class="mini-return {{ row.primary_return_class }}">
              {{ row.primary_return | fmt_pct }}
              <span>{{ row.primary_horizon }} return</span>
            </div>

            <div class="mini-meta">
              <span>{{ row.archetype }}</span>
              <span>{{ row.score_pts }} pts</span>
            </div>
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">BEST ALPHA</div>
          <h2>Top returns versus TOPIX.</h2>
        </div>
        <div class="method-chip">Stock return minus TOPIX ETF return</div>
      </div>

      <div class="mini-card-grid">
        {% for row in top_alpha_rows %}
          <article class="mini-card">
            <div class="mini-top">
              <span>{{ row.eval_date }}</span>
              <strong class="{{ row.triage_css }}">{{ row.triage }}</strong>
            </div>

            <h3>{{ row.symbol }}</h3>
            <p>{{ row.name }}</p>

            <div class="mini-return {{ row.primary_alpha_class }}">
              {{ row.primary_alpha | fmt_pct }}
              <span>{{ row.primary_horizon }} alpha</span>
            </div>

            <div class="mini-meta">
              <span>{{ row.archetype }}</span>
              <span>{{ row.score_pts }} pts</span>
            </div>
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading split-heading">
        <div>
          <div class="kicker">RECENT SIGNAL REPLAY</div>
          <h2>Most recent scored observations.</h2>
        </div>
        <div class="method-chip">Limited view for readability</div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Rank</th>
              <th>Triage</th>
              <th>Symbol</th>
              <th>Name</th>
              <th>Score</th>
              <th>Archetype</th>
              <th>RVOL</th>
              <th>1D</th>
              <th>5D</th>
              <th>{{ primary_horizon }}D Return</th>
              <th>{{ primary_horizon }}D Alpha</th>
              <th>{{ primary_horizon }}D Pullback</th>
            </tr>
          </thead>
          <tbody>
            {% for row in recent_rows %}
              <tr>
                <td>{{ row.eval_date }}</td>
                <td>#{{ row.rank }}</td>
                <td><span class="mini-tag {{ row.triage_css }}">{{ row.triage }}</span></td>
                <td><strong>{{ row.symbol }}</strong></td>
                <td>{{ row.name }}</td>
                <td>{{ row.score_pts }}</td>
                <td>{{ row.archetype }}</td>
                <td>{{ row.volume_ratio_20d | fmt_num }}</td>
                <td class="{{ 'value-up' if row.return_1d_pct and row.return_1d_pct > 0 else 'value-down' if row.return_1d_pct and row.return_1d_pct < 0 else 'value-flat' }}">{{ row.return_1d_pct | fmt_pct }}</td>
                <td class="{{ 'value-up' if row.return_5d_pct and row.return_5d_pct > 0 else 'value-down' if row.return_5d_pct and row.return_5d_pct < 0 else 'value-flat' }}">{{ row.return_5d_pct | fmt_pct }}</td>
                <td class="{{ row.primary_return_class }}">{{ row.primary_return | fmt_pct }}</td>
                <td class="{{ row.primary_alpha_class }}">{{ row.primary_alpha | fmt_pct }}</td>
                <td>{{ row.primary_pullback | fmt_pct }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section-block methodology">
      <div class="section-heading">
        <div class="kicker">METHOD CONTROL</div>
        <h2>No look-ahead, no API calls, no display-layer recalculation.</h2>
        <p>
          The backtest truncates each stock’s OHLCV history to the evaluation date,
          runs the same Daily Event Score v2 engine, and measures future returns using
          trading-day offsets. Daily model health is judged on the short-term range,
          while 20D is shown as a reference horizon only. The rendered page only displays precomputed JSON values.
        </p>
      </div>

      <div class="method-grid">
        <div>
          <span>Scoring Engine</span>
          <strong>Daily Event Score v2</strong>
        </div>
        <div>
          <span>Entry</span>
          <strong>Close on eval date</strong>
        </div>
        <div>
          <span>Alpha Benchmark</span>
          <strong>TOPIX ETF</strong>
        </div>
        <div>
          <span>External API Calls</span>
          <strong>0</strong>
        </div>
      </div>
    </section>

    <section class="notes">
      <strong>Not investment advice.</strong>
      <span>
        Backtest results are historical and do not guarantee future performance.
        Small-cap and low-liquidity Japanese equities can move violently and may be
        difficult to trade at displayed prices.
      </span>
    </section>

    <footer class="footer">
      <span>Informational only. Not investment advice.</span>
      <nav>
        <a href="/">Home</a>
        <a href="/japan/daily/">Daily</a>
        <a href="/privacy/">Privacy</a>
        <a href="/disclaimer/">Disclaimer</a>
      </nav>
    </footer>
  </main>
</div>
</body>
</html>
