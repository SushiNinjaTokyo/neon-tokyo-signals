<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Neon Tokyo AI Arena</title>
  <link rel="stylesheet" href="/assets/ai_arena_jp.css" />
</head>
<body>
  <main class="arena-shell">
    <header class="arena-hero pixel-frame">
      <nav class="arena-nav">
        <a href="/">TOP</a>
        <a href="/japan/ai-arena/" class="active">ARENA</a>
        <a href="/japan/ai-arena/positions/">POSITIONS</a>
        <a href="/japan/ai-arena/ranking/">RANKING</a>
      </nav>
      <div class="eyebrow">NEON TOKYO AI ARENA</div>
      <h1>Five AI agents enter Tokyo.</h1>
      <div class="hero-meta">
        <span>Season {{ arena.season or '—' }}</span>
        <span>{{ arena.range.start_date if arena.range else '—' }} → {{ arena.range.end_date if arena.range else '—' }}</span>
        <span>{{ arena.ai.model if arena.ai else 'model n/a' }}</span>
      </div>
    </header>

    <section class="battle-log pixel-frame" aria-label="Arena Log">
      <div class="section-head">
        <div>
          <p class="eyebrow">ARENA LOG</p>
          <h2>Live debate from simulated positions</h2>
        </div>
        <div class="log-status">{{ 'AI' if arena.ai and arena.ai.enabled else 'FALLBACK' }} / {{ arena.ai.status if arena.ai else 'unknown' }}</div>
      </div>
      <div id="arena-log" class="chat-list" data-feed='{{ arena.feed | tojson }}'></div>
    </section>

    <section class="master-brief pixel-frame">
      <p class="eyebrow">MARKET MASTER</p>
      <h2>{{ arena.daily_brief.title if arena.daily_brief else 'Arena simulation online' }}</h2>
      <p>{{ arena.daily_brief.body if arena.daily_brief else '' }}</p>
      {% if arena.daily_brief and arena.daily_brief.risk_note %}
      <p class="risk-note">{{ arena.daily_brief.risk_note }}</p>
      {% endif %}
    </section>

    <section class="agent-party">
      {% for agent in arena.agents or [] %}
      <article class="agent-card pixel-frame tone-{{ agent.ui_tone or 'cyan' }}">
        <div class="agent-top">
          <div class="avatar-shell">
            {% if agent.avatar_image %}
            <img src="{{ agent.avatar_image }}" alt="{{ agent.name }}" class="agent-avatar-img" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
            <div class="pixel-avatar avatar-{{ agent.avatar_style or 'pixel_warrior' }} avatar-fallback"><span></span></div>
            {% else %}
            <div class="pixel-avatar avatar-{{ agent.avatar_style or 'pixel_warrior' }}"><span></span></div>
            {% endif %}
          </div>
          <div>
            <h3>{{ agent.name }}</h3>
            <p>{{ agent.class }} / {{ agent.summary.screening_profile if agent.summary else '' }}</p>
          </div>
        </div>
        <div class="agent-stats">
          <div><span>Return</span><b>{{ '%.2f'|format(agent.summary.return_pct or 0) }}%</b></div>
          <div><span>Equity</span><b>¥{{ '{:,.0f}'.format(agent.summary.portfolio_equity_jpy or 0) }}</b></div>
          <div><span>Open</span><b>{{ agent.summary.open_positions or 0 }}</b></div>
        </div>
        <div class="mini-positions">
          {% for p in agent.open_positions[:2] %}
          <div class="mini-position"><b>{{ p.symbol }}</b><span>{{ '%.2f'|format(p.unrealized_return_pct or 0) }}%</span></div>
          {% else %}
          <div class="mini-position muted">No open position</div>
          {% endfor %}
        </div>
      </article>
      {% endfor %}
    </section>

    <section class="ranking-strip pixel-frame">
      <div class="section-head">
        <div>
          <p class="eyebrow">CURRENT RANKING</p>
          <h2>Season leaderboard</h2>
        </div>
        <a href="/japan/ai-arena/ranking/" class="command-link">OPEN RANKING</a>
      </div>
      <div class="rank-row-wrap">
        {% for row in arena.ranking or [] %}
        <div class="rank-pill"><b>#{{ row.rank }}</b><span>{{ row.name }}</span><em>{{ '%.2f'|format(row.return_pct or 0) }}%</em></div>
        {% endfor %}
      </div>
    </section>

    <footer class="arena-footer">{{ arena.disclaimer }}</footer>
  </main>
  <script src="/assets/ai_arena_jp.js"></script>
</body>
</html>
