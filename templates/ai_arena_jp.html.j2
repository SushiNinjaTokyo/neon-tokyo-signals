<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Neon Tokyo AI Arena | Synthetic Japan Signal Agents</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Neon Tokyo AI Arena turns Japan equity signals into a synthetic agent battle. Five AI agents select signals; alpha decides the winner."/>
  <meta name="theme-color" content="#050711"/>
  <link rel="stylesheet" href="/assets/ai_arena_jp.css?v=20260524-v1"/>
</head>
<body>
<div class="arena-page" data-generated-at="{{ arena.generated_at or '' }}">
  <div class="arena-bg-grid"></div>
  <div class="arena-glow arena-glow-a"></div>
  <div class="arena-glow arena-glow-b"></div>

  <header class="arena-header pixel-frame">
    <a class="brand" href="/" aria-label="Neon Tokyo Signals home">
      <span class="brand-mark">NTS</span>
      <span>
        <strong>NEON TOKYO AI ARENA</strong>
        <em>Five synthetic investors. One Tokyo market. Alpha decides.</em>
      </span>
    </a>
    <nav class="arena-nav" aria-label="Arena navigation">
      <a href="/japan/daily/">Daily</a>
      <a href="/japan/weekly/">Weekly</a>
      <a href="/japan/daily/backtest/">Backtest</a>
    </nav>
  </header>

  <main class="arena-wrap">
    <section class="hero pixel-frame">
      <div class="hero-copy">
        <p class="kicker"><span class="live-dot"></span> AI SIGNAL BATTLE // JAPAN EQUITIES</p>
        <h1>
          <span>Enter the Tokyo arena.</span>
          <strong>Back the agent with the edge.</strong>
        </h1>
        <p class="hero-note">{{ arena.disclaimer or 'Signal-selection game. Informational only. Not investment advice.' }}</p>
      </div>

      <aside class="brief battle-window" aria-label="Grand Market Analyst brief">
        <div class="window-title">
          <span>GRAND MARKET ANALYST</span>
          <i>{{ arena.ai.model or 'gpt-4o-mini' }}</i>
        </div>
        <h2>{{ arena.daily_brief.title or 'Arena brief unavailable' }}</h2>
        <p>{{ arena.daily_brief.body or 'No daily brief was generated.' }}</p>
        <small>{{ arena.daily_brief.risk_note or 'Risk note unavailable.' }}</small>
      </aside>
    </section>

    <section class="theme-strip pixel-frame" aria-label="Theme heat">
      <div class="section-head compact">
        <span>THEME HEAT</span>
        <strong>Current Japan signal clusters</strong>
      </div>
      <div class="theme-grid">
        {% for theme in arena.top_themes or [] %}
        <div class="theme-chip">
          <span>{{ theme.theme }}</span>
          <b>{{ '%.0f'|format(theme.heat_score or 0) }}</b>
          <i>{{ theme.signal_count or 0 }} signals</i>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="agent-section" aria-label="AI agents">
      <div class="section-head">
        <span>SELECT YOUR AGENT</span>
        <strong>Each agent uses a different signal philosophy.</strong>
      </div>

      <div class="agent-grid">
        {% for agent in arena.agents or [] %}
        {% set pick = agent.pick or {} %}
        <article class="agent-card pixel-frame tone-{{ agent.ui_tone or 'cyan' }}" data-agent-card data-agent-id="{{ agent.agent_id }}">
          <div class="agent-top">
            <div class="agent-avatar {{ agent.avatar_style or '' }}" aria-hidden="true">
              <span></span>
            </div>
            <div>
              <p>{{ agent.class or 'Agent' }}</p>
              <h2>{{ agent.name }}</h2>
            </div>
          </div>

          <div class="pick-box">
            <span class="pick-label">PICK</span>
            <strong>{{ pick.symbol or '—' }}</strong>
            <em>{{ pick.name or 'No signal available' }}</em>
            <small>{{ pick.theme or 'Theme unavailable' }}</small>
          </div>

          <p class="agent-comment">{{ agent.agent_comment or 'Agent comment unavailable.' }}</p>

          <div class="stat-grid" aria-label="Agent stats">
            <div><span>Signal</span><b>{{ agent.stats.signal_power or 0 }}</b></div>
            <div><span>Theme</span><b>{{ agent.stats.theme_heat or 0 }}</b></div>
            <div><span>Guard</span><b>{{ agent.stats.risk_guard or 0 }}</b></div>
            <div><span>Liquid</span><b>{{ agent.stats.liquidity or 0 }}</b></div>
          </div>

          <div class="metric-line">
            <span>5D {{ pick.return_5d_pct if pick.return_5d_pct is not none else '—' }}%</span>
            <span>RVOL {{ pick.volume_ratio_20d if pick.volume_ratio_20d is not none else '—' }}x</span>
            <span>Score {{ pick.score_pts if pick.score_pts is not none else '—' }}</span>
          </div>

          <button class="command-button" type="button" data-back-agent="{{ agent.agent_id }}">Back this Agent</button>
          <p class="backed-note" data-backed-note hidden>Backed on this device</p>
        </article>
        {% endfor %}
      </div>
    </section>

    <section class="arena-lower">
      <div class="battle-log pixel-frame">
        <div class="section-head compact">
          <span>ARENA LOG</span>
          <strong>Scheduled agent lines unlock by time.</strong>
        </div>
        <div id="arenaFeed" class="feed" data-feed='{{ (arena.feed or []) | tojson }}'>
          <div class="feed-empty">Loading Arena feed...</div>
        </div>
      </div>

      <aside class="result-window pixel-frame">
        <div class="section-head compact">
          <span>RESULT</span>
          <strong>{{ arena.arena_result.evaluation_horizon or '1d' }} alpha check</strong>
        </div>
        {% if arena.arena_result.status == 'mature' %}
          <div class="winner-box">
            <span>WINNER</span>
            <strong>{{ arena.arena_result.winner_agent_id or '—' }}</strong>
            <em>{{ arena.arena_result.winner_symbol or '—' }}</em>
          </div>
          <div class="result-metrics">
            <div><span>Return</span><b>{{ arena.arena_result.winner_return_pct if arena.arena_result.winner_return_pct is not none else '—' }}%</b></div>
            <div><span>Alpha</span><b>{{ arena.arena_result.winner_alpha_vs_topix_pct if arena.arena_result.winner_alpha_vs_topix_pct is not none else '—' }}%</b></div>
            <div><span>Eval</span><b>{{ arena.arena_result.winner_eval_date or '—' }}</b></div>
          </div>
        {% else %}
          <div class="pending-box">
            <strong>PENDING</strong>
            <p>Result will appear when the selected horizon matures in Daily Backtest data.</p>
          </div>
        {% endif %}

        <div class="device-choice">
          <span>Your backed agent</span>
          <strong id="userBackedAgent">Not selected</strong>
        </div>
      </aside>
    </section>

    <footer class="arena-footer">
      <span>Generated: {{ arena.generated_at or '—' }}</span>
      <span>AI status: {{ arena.ai.status or 'unknown' }}{% if arena.ai.fallback_used %} / fallback{% endif %}</span>
      <nav>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/privacy/">Privacy</a>
      </nav>
    </footer>
  </main>
</div>

<script src="/assets/ai_arena_jp.js?v=20260524-v1" defer></script>
</body>
</html>
